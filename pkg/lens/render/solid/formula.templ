package solid

import (
	"github.com/iota-uz/iota-sdk/pkg/lens/document"
	"github.com/iota-uz/iota-sdk/pkg/lens/formula"
)

// FormulaMode picks how <lens-formula> presents itself.
type FormulaMode string

const (
	// FormulaTip renders only the ƒ affordance; hover, focus and click open it.
	FormulaTip FormulaMode = "tip"
	// FormulaBlock renders the formula and its variable list in the page.
	FormulaBlock FormulaMode = "block"
)

// FormulaProps is what a server-rendered page hands the component. A page has
// no frame, so each variable's formatted value travels in Values (by key).
type FormulaProps struct {
	Spec formula.Spec
	// Label names the figure ("ROE"); Value is its formatted value.
	Label, Value string
	Values       map[string]string
	Mode         FormulaMode
}

// Formula renders the methodology formula on a templ/HTMX page outside a Lens
// dashboard. The server-rendered MathML is the child of the custom element, so
// the formula reads without JavaScript and in print; the lens bundle upgrades
// it to KaTeX with hover and keyboard access to variable values.
templ Formula(props FormulaProps) {
	{{ wire := formulaWire(props) }}
	<lens-formula
		formula={ formulaJSON(wire) }
		label={ props.Label }
		value={ props.Value }
		mode={ string(formulaMode(props.Mode)) }
	>
		if wire != nil && wire.Markup != "" {
			@templ.Raw(wire.Markup)
		} else if wire != nil && wire.Error {
			<span role="alert">…</span>
		}
	</lens-formula>
}

func formulaMode(m FormulaMode) FormulaMode {
	if m == FormulaBlock {
		return FormulaBlock
	}
	return FormulaTip
}

func formulaWire(props FormulaProps) *document.Formula {
	spec := props.Spec
	variables := make([]formula.Variable, len(spec.Variables))
	copy(variables, spec.Variables)
	for i := range variables {
		if v, ok := props.Values[variables[i].Key]; ok {
			variables[i].Value = v
		}
	}
	spec.Variables = variables
	return document.BuildFormula("templ", &spec)
}
