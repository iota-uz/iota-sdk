        "from": {
          "node": "labeled",
          "outcome": "fired"
        },
        "to": "decide"
      },
      {
        "from": {
          "node": "decide",
          "outcome": "ship"
        },
        "to": "go"
      },
      {
        "from": {
          "node": "decide",
          "outcome": "hold"
        },
        "to": "wait_more"
      },
      {
        "from": {
          "node": "decide",
          "outcome": "failed"
        },
        "to": "wait_more"
      },
      {
        "from": {
          "node": "decide",
          "outcome": "unsure"
        },
        "to": "wait_more"
      }
    ]
  },
  "subject": {
    "repository": "acme/app"
  },
  "context": {
    "issue": {
      "repository": "acme/app",
      "number": 7,
      "title": "Crash on save",
      "labels": [],
