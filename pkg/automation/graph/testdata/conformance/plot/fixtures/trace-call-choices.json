{
  "name": "trace-call-choices",
  "kind": "trace",
  "plot": false,
  "description": "A call node: its outcomes are the values of its choices param plus unsure and failed; dry_run takes the answer from context.nodes.<id>.output, and the outcome is the chosen value.",
