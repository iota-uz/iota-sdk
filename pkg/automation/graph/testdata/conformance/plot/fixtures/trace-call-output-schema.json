{
  "name": "trace-call-output-schema",
  "kind": "trace",
  "plot": false,
  "description": "A call node with a declared output (output_from): the next node's CEL reads its typed fields; a number in an integer field is an int, in a number field a double.",
  "graph": {
    "id": "",
    "version": 0,
    "name": "Sync",
    "attach": {
      "kind": "event"
    },
    "enabled": false,
    "triggers": [
      {
        "id": "labeled",
        "event": "issue.labeled"
      }
    ],
    "nodes": [
      {
        "id": "post",
        "type": "script",
        "params": {
          "outcomes": ["sent", "skipped"],
          "output_schema": {
            "type": "object",
            "properties": {
              "ok": {
                "type": "boolean"
              },
              "count": {
                "type": "integer"
              },
              "state": {
                "type": "string",
                "enum": ["sent", "queued"]
              },
              "ratio": {
                "type": "number"
              }
            },
            "required": ["ok", "count", "state"]
          }
        }
      },
      {
        "id": "check",
        "type": "branch",
        "params": {
          "expression": "nodes.post.output.ok && nodes.post.output.count > 1 && nodes.post.output.state == \"sent\" && nodes.post.output.ratio > 0.5"
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "labeled",
          "outcome": "fired"
        },
        "to": "post"
      },
      {
        "from": {
          "node": "post",
          "outcome": "sent"
        },
        "to": "check"
      },
      {
        "from": {
          "node": "post",
          "outcome": "skipped"
        },
        "to": "ignore"
      },
      {
        "from": {
          "node": "post",
          "outcome": "failed"
        },
        "to": "ignore"
      },
      {
        "from": {
          "node": "check",
          "outcome": "true"
        },
        "to": "ignore"
      },
      {
        "from": {
          "node": "check",
          "outcome": "false"
        },
        "to": "ignore"
      }
    ]
  },
  "subject": {
    "repository": "acme/app"
  },
  "context": {
    "nodes": {
      "post": {
        "outcome": "sent",
        "output": {
          "ok": true,
          "count": 2,
          "state": "sent",
          "ratio": 0.75
        }
      }
    }
  },
  "inputs": [
    {
      "kind": "issue.labeled",
      "label": "sync"
    }
  ],
  "trace": [
    {
      "node": "labeled",
      "outcome": "fired",
      "context_patch": {}
    },
    {
      "node": "post",
      "outcome": "sent",
      "context_patch": {
        "output": {
          "ok": true,
          "count": 2,
          "state": "sent",
          "ratio": 0.75
        },
        "effects": [
          {
            "node": "script",
            "params": {
              "outcomes": ["sent", "skipped"],
              "output_schema": {
                "type": "object",
                "properties": {
                  "ok": {
                    "type": "boolean"
                  },
                  "count": {
                    "type": "integer"
                  },
                  "state": {
                    "type": "string",
                    "enum": ["sent", "queued"]
                  },
                  "ratio": {
                    "type": "number"
                  }
                },
                "required": ["ok", "count", "state"]
              }
            }
          }
        ]
      }
    },
    {
      "node": "check",
      "outcome": "true",
      "context_patch": {}
    },
    {
      "node": "ignore",
      "outcome": "ended",
      "context_patch": {}
    }
  ]
}
