{
  "name": "expressions-guards",
  "format": 2,
  "kind": "expressions",
  "description": "A key of a dyn object is missing only where it is read: has() and in see it as absent, so a guarded read takes its fallback; index and select of an absent key give the same missing path; null elements of a list of dyn are values; int() and string() of dyn values are allowed (the forbidden overloads have no implementation).",
  "catalog_patch": {
    "subjects": {
      "card": {
        "context": {
          "extra": {
            "list": "dyn"
          }
        }
      }
    }
  },
  "cases": [
    {
      "subject": "card",
      "event": null,
      "source": "has(event.data.a) ? event.data.a : \"none\"",
      "type": "any",
      "context": {
        "event": {
          "data": {
            "x": 1
          }
        }
      },
      "value": "none"
    },
    {
      "subject": "card",
      "event": null,
      "source": "has(event.data.a) && event.data.a.b == 1",
      "type": "bool",
      "context": {
        "event": {
          "data": {
            "x": 1
          }
        }
      },
      "value": false
    },
    {
