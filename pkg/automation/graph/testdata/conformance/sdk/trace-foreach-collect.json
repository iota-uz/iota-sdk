{
  "name": "trace-foreach-collect",
  "format": 2,
  "kind": "trace",
  "description": "A foreach runs its body once per item, in the items' order, each item a token reading foreach.<id>.item and .index; collect ends the item with its value; all ok is done.",
  "requires": [
    "behavior:foreach",
    "behavior:collect"
  ],
  "catalog_patch": {
    "nodes": {
      "parallel": {
        "behavior": "parallel"
      },
      "join": {
        "behavior": "join"
      },
      "foreach": {
        "behavior": "foreach"
      },
      "collect": {
        "behavior": "collect"
      }
    }
  },
  "graph": {
    "name": "SDK",
    "triggers": [
      {
        "id": "labeled",
        "event": "issue.labeled"
      }
    ],
    "nodes": [
      {
        "id": "each",
        "type": "foreach",
        "params": {
          "items": "issue.labels"
        }
      },
      {
        "id": "note",
        "type": "action",
        "params": {
          "action": "notify",
          "text": "{{ foreach.each.index }}: {{ foreach.each.item }}"
        }
      },
      {
        "id": "c",
        "type": "collect",
        "params": {
          "of": "each",
          "value": "foreach.each.item + \"!\""
        }
      },
      {
        "id": "go",
        "type": "end",
        "params": {
          "column": "done"
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "labeled",
          "outcome": "fired"
        },
        "to": "each"
      },
      {
        "from": {
          "node": "each",
          "outcome": "item"
        },
        "to": "note"
      },
      {
        "from": {
          "node": "note",
          "outcome": "done"
        },
        "to": "c"
      },
      {
        "from": {
          "node": "note",
          "outcome": "failed"
        },
        "to": "ignore"
      },
      {
        "from": {
          "node": "each",
          "outcome": "done"
        },
        "to": "go"
      },
      {
        "from": {
          "node": "each",
          "outcome": "partial_failed"
        },
        "to": "ignore"
      },
      {
        "from": {
          "node": "each",
          "outcome": "failed"
        },
        "to": "ignore"
      }
    ]
  },
  "context": {
    "issue": {
      "repository": "acme/app",
      "number": 7,
      "title": "Crash on save",
      "labels": [
        "bug",
        "ui"
      ],
      "state": "open"
    },
    "card": {
      "column": "in_progress",
      "tags": [
        "mobile"
      ]
    }
  },
  "inputs": [
    {
      "kind": "issue.labeled",
      "label": "x"
    }
  ],
  "trace": [
    {
      "node": "labeled",
      "outcome": "fired",
      "context_patch": {}
    },
    {
      "node": "note",
      "outcome": "done",
      "context_patch": {
        "effects": [
          {
            "node": "action",
            "params": {
              "action": "notify",
              "text": "0: bug"
            }
          }
        ]
      },
      "token": "each[0]"
    },
    {
      "node": "c",
      "outcome": "arrived",
      "context_patch": {
        "value": "bug!"
      },
      "token": "each[0]"
    },
    {
      "node": "note",
      "outcome": "done",
      "context_patch": {
        "effects": [
          {
            "node": "action",
            "params": {
              "action": "notify",
              "text": "1: ui"
            }
          }
        ]
      },
      "token": "each[1]"
    },
    {
      "node": "c",
      "outcome": "arrived",
      "context_patch": {
        "value": "ui!"
      },
      "token": "each[1]"
    },
    {
      "node": "each",
      "outcome": "done",
      "context_patch": {
        "output": {
          "results": [
            {
              "index": 0,
              "ok": true,
              "value": "bug!"
            },
            {
              "index": 1,
              "ok": true,
              "value": "ui!"
            }
          ]
        }
      }
    },
    {
      "node": "go",
      "outcome": "end",
      "context_patch": {},
      "end": {
        "column": "done"
      }
    }
  ]
}
