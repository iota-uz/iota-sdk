{
  "name": "validate-foreach-escape",
  "format": 2,
  "kind": "validate",
  "description": "Everything a foreach's body reaches stays inside it: a body node also entered after the foreach is foreach_escape at the node, an edge into the collect from outside the body at the edge.",
  "requires": [
    "behavior:foreach",
    "behavior:collect"
  ],
  "catalog_patch": {
    "nodes": {
      "foreach": {
        "behavior": "foreach"
      },
      "collect": {
        "behavior": "collect"
      }
    }
  },
  "graph": {
    "name": "SDK",
    "triggers": [
      {
        "id": "labeled",
        "event": "issue.labeled"
      }
    ],
    "nodes": [
      {
        "id": "each",
        "type": "foreach",
        "params": {
          "items": "issue.labels"
        }
      },
      {
        "id": "note",
        "type": "action",
        "params": {
          "action": "notify",
          "text": "x"
        }
      },
      {
        "id": "c",
        "type": "collect",
        "params": {
          "of": "each"
        }
      }
    ],
    "edges": [
      {
        "from": {
          "node": "labeled",
          "outcome": "fired"
        },
        "to": "each"
      },
      {
        "from": {
          "node": "each",
          "outcome": "item"
        },
        "to": "note"
      },
      {
        "from": {
          "node": "note",
          "outcome": "done"
        },
        "to": "c"
      },
      {
        "from": {
          "node": "note",
          "outcome": "failed"
        },
        "to": "ignore"
      },
      {
        "from": {
          "node": "each",
          "outcome": "done"
        },
        "to": "note"
      },
      {
        "from": {
          "node": "each",
          "outcome": "partial_failed"
        },
        "to": "c"
      },
      {
        "from": {
          "node": "each",
          "outcome": "failed"
        },
        "to": "ignore"
      }
    ]
  },
  "errors": [
    {
      "path": "nodes[1]",
      "code": "foreach_escape"
    },
    {
      "path": "edges[5]",
      "code": "foreach_escape"
    }
  ]
}
