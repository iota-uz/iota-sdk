{
  "name": "iota-sdk-docs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev --port 4000",
    "build": "pnpm check:react-free && astro build && pagefind --site out --output-subdir _pagefind && pnpm check:routes",
    "start": "astro preview --port 4000",
    "check:mermaid": "node ./scripts/validate-mermaid.mjs",
    "typecheck": "tsc --noEmit",
    "test:browser": "playwright test",
    "check:react-free": "node scripts/check-react-free.mjs",
    "check:routes": "node scripts/check-routes.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "4.3.14",
    "@astrojs/solid-js": "5.1.3",
    "astro": "5.18.2",
    "solid-js": "1.9.16"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "4.3.0",
    "@types/node": "^20.17.12",
    "glob": "^13.0.0",
    "jsdom": "^26.1.0",
    "mermaid": "11.12.2",
    "pagefind": "^1.4.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.3",
    "vite": "6.4.1"
  }
}
