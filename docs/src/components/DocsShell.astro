---
import Navigation from "./Navigation.astro";
const {
  items,
  base,
  current,
  breadcrumb,
  headings,
  nextPage,
  previousPage,
  updatedDate,
  updatedLabel,
  sourceCode,
  pageTitle,
  sourcePath,
  languageHref,
  locale,
} = Astro.props;
const tocHeadings = headings.filter(
  (heading: any) => heading.depth >= 2 && heading.depth <= 6,
);
---

<header
  class="nextra-navbar x:sticky x:top-0 x:z-30 x:w-full x:bg-transparent x:print:hidden x:max-md:[.nextra-banner:not([class$=hidden])~&]:top-(--nextra-banner-height)"
>
  <div
    class="nextra-navbar-blur x:absolute x:-z-1 x:size-full nextra-border x:border-b x:backdrop-blur-md x:bg-nextra-bg/70"
  >
  </div><nav
    class="x:mx-auto x:flex x:max-w-(--nextra-content-width) x:items-center x:gap-4 x:pl-[max(env(safe-area-inset-left),1.5rem)] x:pr-[max(env(safe-area-inset-right),1.5rem)] x:justify-end"
    style="height:var(--nextra-navbar-height)"
  >
    <a
      aria-label="Home page"
      class="x:flex x:items-center x:me-auto x:transition-opacity x:focus-visible:nextra-focus x:hover:opacity-75"
      href="/iota-sdk"
      ><div style="font-weight:700;font-size:1.2rem">IOTA SDK</div></a
    ><div
      class="x:flex x:gap-4 x:overflow-x-auto nextra-scrollbar x:py-1.5 x:max-md:hidden"
    >
      <button
        aria-expanded="false"
        aria-haspopup="menu"
        class="x:text-sm x:contrast-more:text-gray-700 x:contrast-more:dark:text-gray-100 x:whitespace-nowrap x:text-gray-600 x:hover:text-black x:dark:text-gray-400 x:dark:hover:text-gray-200 x:ring-inset x:transition-colors x:items-center x:flex x:gap-1.5 x:cursor-pointer"
        id="modules-toggle"
        type="button"
        >Modules<svg
          class="x:*:origin-center x:*:transition-transform x:*:rotate-90"
          fill="none"
          height="14"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          ><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"
          ></path></svg
        ></button
      >
    </div><div class="x:max-md:hidden">
      <div
        class="nextra-search x:relative x:flex x:items-center x:text-gray-900 x:dark:text-gray-300 x:contrast-more:text-gray-800 x:contrast-more:dark:text-gray-300"
      >
        <input
          aria-autocomplete="list"
          aria-expanded="false"
          aria-label="Search documentation"
          autocomplete="off"
          class="x:rounded-lg x:px-3 x:py-2 x:transition-all x:w-full x:md:w-64 x:text-base x:leading-tight x:md:text-sm x:bg-black/[.05] x:dark:bg-gray-50/10 x:placeholder:text-gray-600 x:dark:placeholder:text-gray-400 x:contrast-more:border x:contrast-more:border-current x:[&::-webkit-search-cancel-button]:appearance-none"
          id="docs-search"
          placeholder="Search documentation…"
          role="combobox"
          spellcheck="false"
          type="search"
          value=""
        /><kbd
          class="x:absolute x:my-1.5 x:select-none x:pointer-events-none x:end-1.5 x:transition-all x:h-5 x:rounded x:bg-nextra-bg x:px-1.5 x:font-mono x:text-[11px] x:font-medium x:text-gray-600 x:dark:text-gray-400 x:border nextra-border x:contrast-more:text-current x:items-center x:gap-1 x:flex x:max-sm:hidden not-prose"
          ><span class="x:text-xs">⌘</span>K</kbd
        >
      </div>
    </div><nav class="hidden md:flex items-center gap-5 text-sm">
      <a
        class="text-gray-300 hover:text-white transition-colors"
        href="/iota-sdk/getting-started">Getting Started</a
      ><a
        class="text-gray-300 hover:text-white transition-colors"
        href="/iota-sdk/architecture">Architecture</a
      ><a
        class="text-gray-300 hover:text-white transition-colors"
        href="/iota-sdk/patterns/repositories">Patterns</a
      ><a
        class="text-gray-300 hover:text-white transition-colors"
        href="/iota-sdk/development/module-development">Development</a
      ><a
        class="text-gray-300 hover:text-white transition-colors"
        href="/iota-sdk/api">API Reference</a
      >
    </nav><button
      aria-controls="docs-mobile-nav"
      aria-label="Toggle navigation"
      class="x:transition x:cursor-pointer nextra-hamburger x:md:hidden"
      id="nav-toggle"
      type="button"
      ><svg
        class=""
        height="24"
        stroke="currentColor"
        stroke-linecap="round"
        stroke-width="2"
        viewBox="0 0 24 24"
        ><g><path d="M4 6h16"></path></g><path d="M4 12h16"></path><g
          ><path d="M4 18h16"></path></g
        ></svg
      ></button
    >
  </nav>
</header><aside
  id="docs-mobile-nav"
  class="nextra-mobile-nav x:flex x:flex-col x:fixed x:inset-0 x:pt-(--nextra-navbar-height) x:z-20 x:md:hidden x:bg-nextra-bg x:[transform:translate3d(0,-100%,0)]"
>
  <div class="x:p-4">
    <Navigation items={items} base={base} current={current} />
  </div>
</aside><div id="search-results" hidden></div><div
  class="x:mx-auto x:flex x:max-w-(--nextra-content-width)"
>
  <aside
    class="nextra-sidebar x:print:hidden x:transition-all x:ease-in-out x:max-md:hidden x:flex x:flex-col x:h-[calc(100dvh-var(--nextra-navbar-height))] x:top-(--nextra-navbar-height) x:shrink-0 x:w-64 x:sticky"
    id="docs-nav"
  >
    <div class="x:p-4 x:overflow-y-auto nextra-scrollbar nextra-mask x:grow">
      <div
        class="x:transform-gpu x:transition-all x:ease-in-out x:motion-reduce:transition-none x:opacity-100"
        style="transition-duration:500ms"
      >
        <Navigation base={base} current={current} items={items} />
      </div>
    </div><div
      class="x:sticky x:bottom-0 x:bg-nextra-bg nextra-sidebar-footer x:border-t nextra-border x:flex x:items-center x:gap-2 x:py-4 x:mx-4"
    >
      <button
        
        aria-expanded="false"
        aria-haspopup="listbox"
        aria-label="Toggle theme"
        class="x:cursor-pointer x:h-7 x:rounded-md x:px-2 x:text-xs x:font-medium x:transition-colors x:text-gray-600 x:dark:text-gray-400 x:flex x:items-center x:gap-2 x:grow"
        id="theme-toggle"
        title="Change theme"
        type="button"
        ><svg
          fill="currentColor"
          height="12"
          stroke="currentColor"
          viewBox="2 2 20 20"
          ><path
            d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
            stroke-linecap="round"
            stroke-width="2"></path></svg
        ><span id="theme-label"></span></button
      ><button
        aria-controls="docs-nav"
        aria-expanded="true"
        class="x:transition x:cursor-pointer x:rounded-md x:p-2 x:text-gray-600 x:dark:text-gray-400"
        id="sidebar-collapse"
        title="Collapse sidebar"
        type="button"
        ><svg class="" fill="currentColor" height="12" viewBox="0 0 16 16"
          ><path
            d="M4.177 7.823l2.396-2.396A.25.25 0 017 5.604v4.792a.25.25 0 01-.427.177L4.177 8.177a.25.25 0 010-.354z"
          ></path><path
            d="M0 1.75C0 .784.784 0 1.75 0h12.5C15.216 0 16 .784 16 1.75v12.5A1.75 1.75 0 0114.25 16H1.75A1.75 1.75 0 010 14.25V1.75zm1.75-.25a.25.25 0 00-.25.25v12.5c0 .138.112.25.25.25H9.5v-13H1.75zm12.5 13H11v-13h3.25a.25.25 0 01.25.25v12.5a.25.25 0 01-.25.25z"
            fill-rule="evenodd"></path></svg
        ></button
      >
    </div>
  </aside><nav
    aria-label="table of contents"
    class="nextra-toc x:order-last x:max-xl:hidden x:w-64 x:shrink-0 x:print:hidden"
  >
    <div
      class="x:grid x:grid-rows-[min-content_1fr_min-content] x:sticky x:top-(--nextra-navbar-height) x:text-sm x:max-h-[calc(100vh-var(--nextra-navbar-height))]"
    >
      <p class="x:pt-6 x:px-4 x:font-semibold x:tracking-tight">
        On This Page
      </p><ul
        class="x:p-4 nextra-scrollbar x:overscroll-y-contain x:overflow-y-auto x:hyphens-auto nextra-mask"
      >
        {
          tocHeadings.map((heading: any) => (
            <li class="x:my-2 x:scroll-my-6 x:scroll-py-6">
              <a
                class={
                  "x:focus-visible:nextra-focus " +
                  (heading.depth === 2
                    ? "x:font-semibold "
                    : {
                        3: "x:ms-3 ",
                        4: "x:ms-6 ",
                        5: "x:ms-9 ",
                        6: "x:ms-12 ",
                      }[heading.depth]) +
                  "x:block x:transition-colors x:subpixel-antialiased x:text-gray-600 x:hover:text-gray-900 x:dark:text-gray-400 x:dark:hover:text-gray-300 x:contrast-more:text-gray-900 x:contrast-more:underline x:contrast-more:dark:text-gray-50 x:break-words"
                }
                href={"#" + heading.slug}
              >
                {heading.text}
              </a>
            </li>
          ))
        }
      </ul><div class="x:grid x:gap-2 x:py-4 x:mx-4 x:border-t nextra-border">
        <a
          class="x:focus-visible:nextra-focus x:text-xs x:font-medium x:transition x:text-gray-600 x:dark:text-gray-400 x:hover:text-gray-800 x:dark:hover:text-gray-200 x:contrast-more:text-gray-700 x:contrast-more:dark:text-gray-100"
          href="https://github.com/shuding/nextra/issues/new?title=Feedback%20for%20%E2%80%9CIOTA%20SDK%20Documentation%E2%80%9D&labels=feedback"
          rel="noreferrer"
          target="_blank"
          >Question? Give us feedback<!-- -->
          <svg
            class="x:inline x:align-baseline x:shrink-0"
            fill="none"
            height="1em"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.7"
            viewBox="0 0 24 24"
            ><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg
          ></a
        ><a
          class="x:focus-visible:nextra-focus x:text-xs x:font-medium x:transition x:text-gray-600 x:dark:text-gray-400 x:hover:text-gray-800 x:dark:hover:text-gray-200 x:contrast-more:text-gray-700 x:contrast-more:dark:text-gray-100"
          href={"https://github.com/shuding/nextra/" + sourcePath}
          rel="noreferrer"
          target="_blank"
          >Edit this page<!-- -->
          <svg
            class="x:inline x:align-baseline x:shrink-0"
            fill="none"
            height="1em"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.7"
            viewBox="0 0 24 24"
            ><path d="M7 17L17 7"></path><path d="M7 7h10v10"></path></svg
          ></a
        ><button
          id="back-to-top"
          aria-label="Back to top"
          aria-hidden="true"
          class="x:transition x:cursor-pointer x:flex x:items-center x:gap-1.5 x:whitespace-nowrap x:opacity-0 x:text-xs x:font-medium x:transition x:text-gray-600 x:dark:text-gray-400 x:hover:text-gray-800 x:dark:hover:text-gray-200 x:contrast-more:text-gray-700 x:contrast-more:dark:text-gray-100"
          data-disabled=""
          disabled=""
          type="button"
          ><svg
            class="x:-rotate-90 x:border x:rounded-full x:border-current"
            fill="none"
            height="1.1em"
            stroke="currentColor"
            stroke-width="2"
            viewBox="0 0 24 24"
            ><path
              d="M9 5l7 7-7 7"
              stroke-linecap="round"
              stroke-linejoin="round"></path></svg
          ></button
        >
      </div>
    </div>
  </nav><article
    class="x:w-full x:min-w-0 x:break-words x:min-h-[calc(100vh-var(--nextra-navbar-height))] x:text-slate-700 x:dark:text-slate-200 x:pb-8 x:px-4 x:pt-4 x:md:px-12"
  >
    <div
      class="nextra-breadcrumb x:mt-1.5 x:flex x:items-center x:gap-1 x:overflow-hidden x:text-sm x:text-gray-600 x:dark:text-gray-400 x:contrast-more:text-current"
    >
      {
        breadcrumb.map((crumb, index) => (
          <>
            {index > 0 && (
              <svg
                class="x:shrink-0 x:rtl:rotate-180"
                fill="none"
                height="14"
                stroke="currentColor"
                stroke-width="2"
                viewBox="0 0 24 24"
              >
                <path
                  d="M9 5l7 7-7 7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            )}
            {index === breadcrumb.length - 1 ? (
              <span
                class="x:whitespace-nowrap x:transition-colors x:font-medium x:text-black x:dark:text-gray-100"
                title={crumb.title}
              >
                {crumb.title}
              </span>
            ) : crumb.href ? (
              <a
                class="x:whitespace-nowrap x:transition-colors x:min-w-6 x:overflow-hidden x:text-ellipsis x:focus-visible:nextra-focus x:ring-inset x:hover:text-gray-900 x:dark:hover:text-gray-100"
                href={crumb.href}
                title={crumb.title}
              >
                {crumb.title}
              </a>
            ) : (
              <span
                class="x:whitespace-nowrap x:transition-colors x:min-w-6 x:overflow-hidden x:text-ellipsis"
                title={crumb.title}
              >
                {crumb.title}
              </span>
            )}
          </>
        ))
      }
    </div><div
      class="x:border x:inline-flex x:rounded-md x:items-stretch nextra-border x:float-end x:overflow-hidden"
    >
      <button
        class="x:transition x:cursor-pointer x:ps-2 x:pe-1 x:flex x:gap-2 x:text-sm x:font-medium x:items-center"
        id="copy-page"
        type="button"
        ><svg
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="16"
          ><rect height="13" rx="2" width="13" x="9" y="9"></rect><path
            d="M5 15H4C2.89543 15 2 14.1046 2 13V4C2 2.89543 2.89543 2 4 2H13C14.1046 2 15 2.89543 15 4V5"
          ></path></svg
        >Copy page</button
      ><button
        id="copy-menu-toggle"
        aria-expanded="false"
        aria-haspopup="listbox"
        class="x:cursor-pointer x:h-7 x:rounded-md x:px-2 x:text-xs x:font-medium x:transition-colors x:text-gray-600 x:dark:text-gray-400 x:rounded-none"
        type="button"
        ><svg
          class="x:rotate-90"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          width="12"
          ><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"
          ></path></svg
        ></button
      >
    </div><div id="nextra-skip-nav"></div><main data-pagefind-body="true">
      <slot />
    </main><div
      class="x:mt-12 x:mb-8 x:text-xs x:text-gray-600 x:text-end x:dark:text-gray-400"
    >
      Last updated on <time datetime={updatedDate}>{updatedLabel}</time>
    </div><div
      class="x:mb-8 x:flex x:items-center x:border-t x:pt-8 nextra-border x:print:hidden"
    >
      {
        previousPage && (
          <a
            class="x:focus-visible:nextra-focus x:text-gray-600 x:dark:text-gray-400 x:hover:text-gray-800 x:dark:hover:text-gray-200 x:contrast-more:text-gray-700 x:contrast-more:dark:text-gray-100 x:flex x:max-w-[50%] x:items-center x:gap-1 x:py-4 x:text-base x:font-medium x:transition-colors x:[word-break:break-word] x:md:text-lg x:pe-4"
            href={previousPage.href}
            title={previousPage.title}
          >
            <svg
              class="x:inline x:shrink-0 x:ltr:rotate-180"
              fill="none"
              height="20"
              stroke="currentColor"
              stroke-width="2"
              viewBox="0 0 24 24"
            >
              <path
                d="M9 5l7 7-7 7"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            {previousPage.title}
          </a>
        )
      }
      <a
        class="x:focus-visible:nextra-focus x:text-gray-600 x:dark:text-gray-400 x:hover:text-gray-800 x:dark:hover:text-gray-200 x:flex x:max-w-[50%] x:items-center x:gap-1 x:py-4 x:text-base x:font-medium x:transition-colors x:md:text-lg x:ps-4 x:ms-auto x:text-end"
        href={nextPage?.href}
        title={nextPage?.title}
        >{nextPage?.title}<svg
          class="x:inline x:shrink-0"
          fill="none"
          height="20"
          stroke="currentColor"
          stroke-width="2"
          viewBox="0 0 24 24"
          ><path d="M9 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"
          ></path></svg
        ></a
      >
    </div>
  </article>
</div>

<div id="modules-menu" class="docs-module-menu" hidden>
  {
    items
      .filter((item) => item.menu)
      .flatMap((item) => item.children)
      .map((item) => <a href={item.href}>{item.title}</a>)
  }
</div>

<script
  id="docs-page-source"
  type="application/json"
  set:html={JSON.stringify(sourceCode ?? " ").replaceAll("<", "\\u003c")}
/>

<ul
  id="theme-menu"
  role="listbox"
  aria-label="Theme"
  class="x:focus-visible:nextra-focus x:opacity-100 x:motion-reduce:transition-none x:transition-opacity x:min-w-(--button-width) x:z-30 x:max-h-64 x:rounded-md x:border x:border-black/5 x:backdrop-blur-md x:bg-nextra-bg/70 x:py-1 x:text-sm x:shadow-lg x:dark:border-white/20 docs-choice-menu x:nextra-focus" tabindex="0"
  hidden
>
  {
    ["light", "dark", "system"].map((value) => (
      <li
        role="option"
        data-theme-choice={value}
        tabindex="-1"
        class="x:text-gray-800 x:dark:text-gray-100 x:cursor-pointer x:whitespace-nowrap x:py-1.5 x:px-3 x:transition-colors"
      >
        {value[0].toUpperCase() + value.slice(1)}
      </li>
    ))
  }
</ul>

<ul
  id="copy-menu"
  role="listbox"
  aria-label="Copy page options"
  class="x:focus-visible:nextra-focus x:opacity-100 x:motion-reduce:transition-none x:transition-opacity x:min-w-(--button-width) x:z-30 x:max-h-64 x:rounded-md x:border x:border-black/5 x:backdrop-blur-md x:bg-nextra-bg/70 x:py-1 x:text-sm x:shadow-lg x:dark:border-white/20 docs-choice-menu x:nextra-focus" tabindex="0"
  hidden
>
  <li
    role="option"
    tabindex="-1"
    aria-selected="false"
    data-copy-choice="copy"
    class="x:text-gray-800 x:dark:text-gray-100 x:cursor-pointer x:whitespace-nowrap x:py-1.5 x:px-3 x:transition-colors"
  >
    <div class="x:flex x:gap-3 x:items-center">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        width="16"
        ><rect x="9" y="9" width="13" height="13" rx="2"></rect><path
          d="M5 15H4C2.89543 15 2 14.1046 2 13V4C2 2.89543 2.89543 2 4 2H13C14.1046 2 15 2.89543 15 4V5"
        ></path></svg
      ><div class="x:flex x:flex-col">
        <span class="x:font-medium x:flex x:gap-1">Copy page</span><span
          class="x:text-xs">Copy page as Markdown for LLMs</span>
      </div>
    </div>
  </li><li
    role="option"
    tabindex="-1"
    aria-selected="false"
    data-copy-choice="chatgpt"
    class="x:text-gray-800 x:dark:text-gray-100 x:cursor-pointer x:whitespace-nowrap x:py-1.5 x:px-3 x:transition-colors"
  >
    <div class="x:flex x:gap-3 x:items-center">
