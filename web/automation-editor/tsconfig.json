{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["vite/client", "vitest/globals", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": {
      "@iota-uz/sdk/solid-ui": ["../solid-ui/src/index.ts"]
    }
  },
  "include": ["src", "fixture", "e2e/**/*.ts", "playwright.config.ts", "vite.config.ts", "vite.package.config.ts", "vite.package.ssr.config.ts", "vitest.config.ts"]
}
