{
  "$comment": "Host conformance cases: run by web/runtime/tests/conformance.test.ts (TS test host) and pkg/extruntime/e2e/conformance_test.go (Go host + PostgreSQL). A step is one invocation of e2e.conformance.write|read|flow; {\"$ref\": label} is the ref of a seeded row; an error expectation is the error code (\"*\" = any error).",
  "cases": [
    {
      "name": "filters follow SQL null semantics",
      "user": {
        "permissions": [
          "e2e.conformance.readAll",
          "e2e.conformance.seeSecret"
        ]
      },
      "seed": [
        {
          "label": "a",
          "entity": "item",
          "values": {
            "name": "a",
            "rank": 1,
            "tag": "public",
            "secret": "s-a"
          }
        },
        {
          "label": "b",
          "entity": "item",
          "values": {
            "name": "b",
            "rank": 2,
            "tag": null
          }
        },
        {
          "label": "c",
          "entity": "item",
          "values": {
            "name": "c",
            "rank": null,
            "tag": "private",
            "secret": "s-c"
          }
        },
        {
          "label": "d",
          "entity": "item",
          "values": {
            "name": "d",
            "rank": 3,
            "tag": "public"
          }
        }
      ],
      "steps": [
        {
          "via": "read",
          "step": {
            "op": "find",
            "entity": "item",
            "select": [
              "name"
            ],
            "where": {
              "tag": "public"
            },
            "orderBy": [
              {
                "field": "name"
              }
            ]
          },
          "expect": {
            "ok": [
              {
                "name": "a"
              },
              {
                "name": "d"
              }
            ]
          }
        },
        {
          "via": "read",
          "step": {
            "op": "find",
            "entity": "item",
            "select": [
              "name"
            ],
            "where": {
              "tag": {
                "ne": "public"
              }
            },
            "orderBy": [
              {
                "field": "name"
              }
            ]
          },
          "expect": {
            "ok": [
              {
                "name": "b"
              },
              {
                "name": "c"
              }
            ]
          },
          "note": "ne is IS DISTINCT FROM: a null tag matches"
        },
        {
          "via": "read",
          "step": {
            "op": "find",
            "entity": "item",
            "select": [
              "name"
            ],
            "where": {
              "tag": {
                "eq": null
              }
            },
            "orderBy": [
              {
                "field": "name"
              }
            ]
          },
          "expect": {
            "ok": [
              {
                "name": "b"
              }
            ]
          },
          "note": "eq null is IS NULL"
        },
        {
          "via": "read",
          "step": {
            "op": "find",
            "entity": "item",
            "select": [
              "name"
            ],
            "where": {
              "tag": {
                "isNull": false
              }
            },
            "orderBy": [
              {
                "field": "name"
              }
            ]
          },
          "expect": {
            "ok": [
              {
                "name": "a"
              },
              {
                "name": "c"
              },
              {
                "name": "d"
              }
            ]
          }
        },
        {
          "via": "read",
          "step": {
            "op": "find",
            "entity": "item",
            "select": [
              "name"
            ],
            "where": {
              "rank": {
                "gt": 1
              }
            },
            "orderBy": [
              {
                "field": "name"
              }
            ]
          },
          "expect": {
            "ok": [
              {
                "name": "b"
              },
              {
                "name": "d"
              }
            ]
          },
          "note": "a range never matches null"
        },
        {
          "via": "read",
          "step": {
            "op": "find",
            "entity": "item",
            "select": [
              "name"
            ],
            "where": {
              "tag": {
                "in": []
              }
            },
            "orderBy": [
              {
                "field": "name"
              }
            ]
          },
          "expect": {
            "ok": []
          }
        },
        {
          "via": "read",
          "step": {
            "op": "find",
            "entity": "item",
            "select": [
              "name"
            ],
            "where": {
              "tag": {
                "in": [
                  "public",
                  "private"
                ]
              }
            },
            "orderBy": [
              {
                "field": "name"
              }
            ]
          },
          "expect": {
            "ok": [
              {
                "name": "a"
              },
              {
                "name": "c"
              },
              {
                "name": "d"
              }
            ]
          }
        },
        {
          "via": "read",
          "step": {
            "op": "find",
            "entity": "item",
            "select": [
              "name"
            ],
            "where": {
              "or": [
                {
                  "rank": 1
                },
                {
                  "tag": "private"
                }
              ]
            },
            "orderBy": [
              {
                "field": "name"
              }
            ]
          },
          "expect": {
            "ok": [
              {
                "name": "a"
              },
              {
                "name": "c"
              }
            ]
          }
        },
        {
          "via": "read",
          "step": {
            "op": "find",
            "entity": "item",
            "select": [
              "name"
            ],
            "where": {
              "tag": "public",
              "or": [
                {
                  "name": "a"
                },
                {
                  "name": "b"
                }
              ]
            },
            "orderBy": [
              {
                "field": "name"
              }
            ]
          },
          "expect": {
            "ok": [
              {
                "name": "a"
              }
            ]
          }
        },
        {
          "via": "read",
          "step": {
            "op": "find",
            "entity": "item",
            "select": [
              "name"
            ],
            "where": {
              "name": {
                "like": "%c"
              }
            },
            "orderBy": [
              {
                "field": "name"
              }
            ]
          },
          "expect": {
            "ok": [
              {
                "name": "c"
              }
            ]
          }
        },
        {
          "via": "read",
          "step": {
            "op": "count",
            "entity": "item",
            "where": {
              "tag": "public"
            }
          },
          "expect": {
            "ok": 2
          }
        },
        {
          "via": "read",
          "step": {
            "op": "find",
            "entity": "item",
            "select": [
              "name"
            ],
            "where": {
              "nope": 1
            },
            "orderBy": [
              {
                "field": "name"
              }
            ]
          },
          "expect": {
            "error": "data.unknownField"
          }
        }
      ]
    },
