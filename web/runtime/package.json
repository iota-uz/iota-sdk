{
  "name": "@iota-uz/sdk-runtime-internal",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/build-host.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.typetests.json && tsc --noEmit -p src/host/tsconfig.json",
    "typecheck:types": "tsc --noEmit -p tsconfig.typetests.json",
    "test": "vitest run && pnpm test:client-host",
    "build-host": "node scripts/build-host.mjs",
    "test:client-host": "vitest run --config src/client-host/vitest.config.ts"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "24.x",
    "jsdom": "25.0.1",
    "solid-js": "1.9.15",
    "typescript": "5.7.2",
    "vitest": "2.1.9"
  }
}
