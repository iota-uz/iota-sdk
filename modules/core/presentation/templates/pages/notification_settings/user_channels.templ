package notification_settings

import (
	"github.com/iota-uz/iota-sdk/components/base/button"
	"github.com/iota-uz/iota-sdk/components/base/input"
	"github.com/iota-uz/iota-sdk/components/scaffold/filterbuilder"
	"github.com/iota-uz/iota-sdk/modules/core/notifications"
	"github.com/iota-uz/iota-sdk/modules/core/presentation/templates/layouts"
	"github.com/iota-uz/iota-sdk/pkg/composables"
	"github.com/iota-uz/iota-sdk/pkg/filterq"
	"net/url"
	"strconv"
)

const userChannelsPath = "/settings/notifications/users"

// HTMX targets of the channels-per-person page: the list a search or chip
// change replaces, and the "Show more" button the next page replaces.
const (
	UserChannelsListID = "notification-user-channels-list"
	UserChannelsMoreID = "user-channels-more"
)

// ChannelLabelKey is the locale key naming a channel.
func ChannelLabelKey(channel notifications.Channel) string {
	return "NotificationSettings.Channel" + channelKey(channel)
}

// UserChannelRow is one person with the channels they opted out of.
type UserChannelRow struct {
	Recipient Recipient
	Disabled  []notifications.Channel
	// Links is the state of the person's account on each linked channel:
	// "linked", "not_linked" or "gone" (the provider ended it).
	Links map[notifications.Channel]string
}

// linkStateKey is the locale key of a link state.
func linkStateKey(state string) string {
	switch state {
	case "linked":
		return "NotificationSettings.LinkState.Linked"
	case "gone":
		return "NotificationSettings.LinkState.Gone"
	}
	return "NotificationSettings.LinkState.NotLinked"
}

type UserChannelsProps struct {
	Rows     []UserChannelRow
	Channels []notifications.Channel
	// Labels name the registered channels in the page's language.
	Labels     map[notifications.Channel]string
	Search     string
	CanManage  bool
	MessageKey string
	// Filters is the filter chip bar; a nil Registry hides it.
	Filters filterbuilder.Props
	// Offset is where Rows start; HasMore says another page follows.
	Offset  int
	HasMore bool
}

// listQuery is the search and chips of the page, as the save forms and the
// next page carry them.
func (props *UserChannelsProps) listQuery() url.Values {
	q := filterq.Encode(props.Filters.Filters)
	if props.Search != "" {
		q.Set("q", props.Search)
	}
	if props.Filters.Registry != nil {
		q.Set(filterq.PresenceParam, "1")
	}
	return q
}

func (props *UserChannelsProps) nextPageURL() string {
	q := props.listQuery()
	q.Set("offset", strconv.Itoa(props.Offset+len(props.Rows)))
	return userChannelsPath + "?" + q.Encode()
}

func channelEnabled(row UserChannelRow, channel notifications.Channel) bool {
	for _, c := range row.Disabled {
		if c == channel {
			return false
		}
	}
	return true
}

templ UserChannels(props *UserChannelsProps) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	@layouts.Authenticated(layouts.AuthenticatedProps{BaseProps: layouts.BaseProps{Title: pageCtx.T("NotificationSettings.UserChannels")}}) {
		@UserChannelsContent(props)
	}
}

templ UserChannelsContent(props *UserChannelsProps) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	<main id="notification-user-channels" class="p-6 md:p-8 max-w-4xl mx-auto">
		<a href="/settings/notifications" class="text-sm text-200 hover:text-100">{ pageCtx.T("NotificationSettings.Title") }</a>
		<header class="mb-4 mt-2">
			<h1 class="text-2xl font-semibold">{ pageCtx.T("NotificationSettings.UserChannels") }</h1>
			<p class="text-sm text-200 mt-1">{ pageCtx.T("NotificationSettings.UserChannelsIntro") }</p>
			if props.MessageKey != "" {
				<p role="status" class="text-sm text-200 mt-2">{ pageCtx.T("NotificationSettings."+props.MessageKey) }</p>
			}
		</header>
		<form
			id="notification-user-channels-filters"
			method="get"
			action={ templ.SafeURL(userChannelsPath) }
			class="mb-4 flex flex-wrap gap-2"
			hx-get={ userChannelsPath }
			hx-trigger="submit, keyup[!target.closest('[data-fb-popover]')] changed delay:500ms from:(#notification-user-channels-filters input[name='q']), filter-changed"
			hx-target={ "#" + UserChannelsListID }
			hx-swap="outerHTML"
			hx-push-url="true"
		>
			<input type="search" name="q" value={ props.Search } maxlength="100" placeholder={ pageCtx.T("NotificationSettings.SearchPeople") } class="block min-w-0 flex-1 rounded-lg border border-secondary bg-surface-300 px-3 py-2"/>
			@button.Secondary(button.Props{Size: button.SizeSM, Attrs: templ.Attributes{"type": "submit"}}) {
				{ pageCtx.T("NotificationSettings.Search") }
			}
			if props.Filters.Registry != nil && len(props.Filters.Registry.Fields()) > 0 {
				<div class="w-full">
					@filterbuilder.Builder(props.Filters)
				</div>
			}
		</form>
		@UserChannelsList(props)
	</main>
}

// UserChannelsListWithChips answers a search or chip change: the list plus the
// chip bar, swapped out-of-band since it sits in the form above.
templ UserChannelsListWithChips(props *UserChannelsProps) {
	@UserChannelsList(props)
	if props.Filters.Registry != nil && len(props.Filters.Registry.Fields()) > 0 {
		@filterbuilder.BuilderOOB(props.Filters)
	}
}

templ UserChannelsList(props *UserChannelsProps) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	<div id={ UserChannelsListID }>
		if len(props.Rows) == 0 {
			<p class="text-sm text-200">{ pageCtx.T("NotificationSettings.NoPeople") }</p>
		}
		@UserChannelRows(props)
	</div>
}

// UserChannelRows renders one page of people and, when more follow, the
// button that loads the next page in its place.
templ UserChannelRows(props *UserChannelsProps) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	for _, row := range props.Rows {
		<form method="post" action={ templ.SafeURL("/settings/notifications/users/" + strconv.FormatUint(uint64(row.Recipient.ID), 10)) } class="mb-3 flex flex-wrap items-center gap-4 rounded-xl border border-secondary bg-surface-300 px-5 py-3" data-testid="user-channels-row">
			for key, values := range props.listQuery() {
				for _, value := range values {
					<input type="hidden" name={ key } value={ value }/>
				}
			}
			<!-- The row's own page: after "Show more" a saved row sits past offset 0,
			     and re-rendering from the top would drop it. Search and chip
			     changes do not send it, so they start at the first page. -->
			if props.Offset > 0 {
				<input type="hidden" name="offset" value={ strconv.Itoa(props.Offset) }/>
			}
			<span class="mr-auto">
				<span class="font-medium">{ row.Recipient.Name }</span>
				if row.Recipient.Hint != "" {
					<span class="block text-sm text-200">{ row.Recipient.Hint }</span>
				}
			</span>
			for _, channel := range props.Channels {
				<span class="inline-flex flex-col">
					@input.Checkbox(&input.CheckboxProps{
						Label:   ChannelLabel(pageCtx, props.Labels, channel),
						Class:   templ.Classes("text-sm font-normal"),
						Checked: channelEnabled(row, channel),
						Attrs:   templ.Attributes{"name": "channels", "value": string(channel), "disabled": !props.CanManage},
					})
					if state, ok := row.Links[channel]; ok {
						<span class="text-xs text-200" data-testid={ "link-state-" + string(channel) }>{ pageCtx.T(linkStateKey(state)) }</span>
					}
				</span>
			}
			if props.CanManage {
				@button.Primary(button.Props{Size: button.SizeSM, Attrs: templ.Attributes{"type": "submit"}}) {
					{ pageCtx.T("NotificationSettings.Save") }
				}
			}
		</form>
	}
	if props.HasMore {
		<div id={ UserChannelsMoreID } class="mb-3">
			<a
				href={ templ.SafeURL(props.nextPageURL()) }
				hx-get={ props.nextPageURL() }
				hx-target={ "#" + UserChannelsMoreID }
				hx-swap="outerHTML"
				class="text-sm text-200 hover:text-100"
			>
				{ pageCtx.T("NotificationSettings.ShowMore") }
			</a>
		</div>
	}
}
