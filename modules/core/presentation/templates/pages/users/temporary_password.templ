package users

import (
	"fmt"

	"github.com/iota-uz/iota-sdk/components/base/card"
	"github.com/iota-uz/iota-sdk/pkg/composables"
)

// TemporaryPasswordProps describes a temporary password that is rendered to
// the administrator once and cannot be viewed again.
type TemporaryPasswordProps struct {
	Email     string
	Password  string
	ExpiresAt string
	BackURL   string
}

templ TemporaryPassword(p TemporaryPasswordProps) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	<div
		class="rounded-lg border border-green-300 bg-green-50 p-4 flex flex-col gap-2 text-green-900"
		data-testid="temporary-password-result"
		x-data="{ copied: false }"
	>
		<p class="font-medium">
			{ pageCtx.T("Users.TemporaryPassword.Issued", map[string]interface{}{"Email": p.Email}) }
		</p>
		<div class="flex flex-wrap items-center gap-2">
			<code
				class="px-3 py-1 rounded bg-white border border-green-300 font-mono text-base select-all"
				data-testid="temporary-password-value"
				x-ref="temporaryPassword"
			>{ p.Password }</code>
			<button
				type="button"
				class="btn btn-secondary btn-sm"
				@click="navigator.clipboard.writeText($refs.temporaryPassword.textContent).then(() => copied = true)"
			>
				<span x-show="!copied">{ pageCtx.T("Users.TemporaryPassword.Copy") }</span>
				<span x-show="copied" x-cloak>{ pageCtx.T("Users.TemporaryPassword.Copied") }</span>
			</button>
		</div>
		<p class="text-sm">
			{ pageCtx.T("Users.TemporaryPassword.ExpiresAt") }
			<time
				datetime={ p.ExpiresAt }
				data-testid="temporary-password-expires-at"
				x-text={ fmt.Sprintf("new Date('%s').toLocaleString(document.documentElement.lang || undefined)", p.ExpiresAt) }
			>{ p.ExpiresAt }</time>
		</p>
		<p class="text-sm">{ pageCtx.T("Users.TemporaryPassword.ShownOnce") }</p>
	</div>
}

templ Created(p TemporaryPasswordProps) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	<div class="flex flex-col gap-5 p-4 md:p-6" data-testid="user-created">
		@card.Card(card.Props{Class: "flex flex-col gap-4"}) {
			@TemporaryPassword(p)
			<div>
				<a href={ templ.SafeURL(p.BackURL) } class="btn btn-primary btn-md">{ pageCtx.T("Users.TemporaryPassword.BackToUsers") }</a>
			</div>
		}
	</div>
}
