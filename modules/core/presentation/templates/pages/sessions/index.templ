package sessions

import (
	"fmt"
	corecomponents "github.com/iota-uz/iota-sdk/modules/core/presentation/templates/components"
	"net/url"
	"strconv"

	icons "github.com/iota-uz/icons/phosphor"
	"github.com/iota-uz/iota-sdk/components/base"
	"github.com/iota-uz/iota-sdk/components/base/badge"
	"github.com/iota-uz/iota-sdk/components/base/button"
	"github.com/iota-uz/iota-sdk/components/base/input"
	sdkhelp "github.com/iota-uz/iota-sdk/components/help"
	"github.com/iota-uz/iota-sdk/components/loaders"
	"github.com/iota-uz/iota-sdk/components/scaffold/filterbuilder"
	"github.com/iota-uz/iota-sdk/modules/core/presentation/templates/layouts"
	"github.com/iota-uz/iota-sdk/modules/core/presentation/viewmodels"
	"github.com/iota-uz/iota-sdk/pkg/composables"
)

type IndexPageProps struct {
	Sessions    []*viewmodels.AdminSessionViewModel
	Page        int
	PerPage     int
	TotalCount  int
	HasMore     bool
	SearchQuery string
	// BasePath is where the list is served; empty means /settings/sessions.
	BasePath string
	// Query is the request query; the next page keeps its search and chips.
	Query url.Values
	// Filters is the filter chip bar; a nil Registry hides it.
	Filters filterbuilder.Props
}

func (props *IndexPageProps) basePath() string {
	if props.BasePath != "" {
		return props.BasePath
	}
	return "/settings/sessions"
}

func mkInfiniteAttrs(props *IndexPageProps) templ.Attributes {
	params := url.Values{}
	for k, v := range props.Query {
		params[k] = append([]string(nil), v...)
	}
	params.Set("page", strconv.Itoa(props.Page+1))
	params.Set("limit", strconv.Itoa(props.PerPage))
	if props.SearchQuery != "" {
		params.Set("search", props.SearchQuery)
	}

	return templ.Attributes{
		"hx-get":     props.basePath() + "?" + params.Encode(),
		"hx-trigger": "intersect once",
		"hx-swap":    "afterend",
		"hx-target":  "this",
	}
}

templ SessionRow(session *viewmodels.AdminSessionViewModel, attrs ...templ.Attributes) {
	{{
		pageCtx := composables.UsePageCtx(ctx)
		rowProps := &base.TableRowProps{
			Attrs: templ.Attributes{
				"id":    fmt.Sprintf("session-row-%s", session.TokenID),
				"class": "hide-on-load",
			},
		}
		// The last row of a page carries the infinite-scroll request.
		for _, extra := range attrs {
			for k, v := range extra {
				rowProps.Attrs[k] = v
			}
		}
	}}
	@base.TableRow(*rowProps) {
		@base.TableCell(base.TableCellProps{}) {
			if session.User != nil {
				<div class="flex flex-col">
					<a
						href={ templ.URL(fmt.Sprintf("/users/%s", session.User.ID)) }
						class="text-primary hover:underline font-medium"
					>
						{ session.User.Title() }
					</a>
					<span class="text-sm text-surface-200">{ session.User.Email }</span>
				</div>
			} else {
				<span class="text-surface-200">{ pageCtx.T("Unknown") }</span>
			}
		}
		@base.TableCell(base.TableCellProps{}) {
			<div class="flex flex-col">
				<span class="font-medium">{ session.Browser }</span>
				<span class="text-sm text-surface-200">{ session.Device } • { session.OS }</span>
			</div>
		}
		@base.TableCell(base.TableCellProps{}) {
			<div class="flex items-center gap-2">
				<span>{ session.IPAddress }</span>
				if session.IsCurrent {
					@badge.New(badge.Props{
						Variant: badge.VariantGreen,
						Size:    badge.SizeNormal,
					}) {
						{ pageCtx.T("Sessions.List.CurrentSession") }
					}
				}
			</div>
		}
		@base.TableCell(base.TableCellProps{}) {
			@corecomponents.LocalDateTime(session.CreatedAtISO)
		}
		@base.TableCell(base.TableCellProps{}) {
			if !session.IsCurrent {
				@button.Danger(button.Props{
					Fixed: true,
					Size:  button.SizeSM,
					Class: "btn-fixed",
					Attrs: templ.Attributes{
						"hx-delete":  fmt.Sprintf("/settings/sessions/%s", session.RawToken),
						"hx-confirm": pageCtx.T("Sessions.List.ConfirmRevoke"),
						"hx-swap":    "outerHTML swap:0s",
						"hx-target":  "closest tr",
					},
				}) {
					@icons.Trash(icons.Props{Size: "20"})
				}
			}
		}
	}
}

templ SessionRows(props *IndexPageProps) {
	<tr class="hidden">
		<td colspan="5">
			@loaders.Spinner(loaders.SpinnerProps{
				ContainerClass: templ.Classes(
					"flex justify-center items-center py-4",
				),
			})
		</td>
	</tr>
	for ix, session := range props.Sessions {
		if ix == len(props.Sessions)-1 && props.HasMore {
			@SessionRow(session, mkInfiniteAttrs(props))
		} else {
			@SessionRow(session)
		}
	}
}

// SessionRowsWithChips answers a search from a page whose form still targets
// the table body: the rows plus the chip bar, swapped out-of-band.
templ SessionRowsWithChips(props *IndexPageProps) {
	@SessionRows(props)
	if props.Filters.Registry != nil {
		@filterbuilder.BuilderOOB(props.Filters)
	}
}

// SessionsListWithChips answers a search or chip change: the list (table or
// empty state) plus the chip bar, swapped out-of-band since it sits in the
// form above.
templ SessionsListWithChips(props *IndexPageProps) {
	@SessionsList(props)
	if props.Filters.Registry != nil {
		@filterbuilder.BuilderOOB(props.Filters)
	}
}

// SessionsList is the table of sessions, or the empty state; search and chip
// changes replace it whole, so an empty result can turn back into rows.
templ SessionsList(props *IndexPageProps) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	<div id="sessions-list">
		if len(props.Sessions) > 0 {
			@SessionsTable(props)
		} else {
			<div class="p-8 text-center text-surface-200">
				<div class="flex flex-col items-center gap-2">
					@icons.ClockCounterClockwise(icons.Props{Size: "48", Class: "text-surface-300"})
					<p class="text-lg">{ pageCtx.T("Sessions.List.EmptyState") }</p>
				</div>
			</div>
		}
	</div>
}

templ SessionsTable(props *IndexPageProps) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	@base.Table(base.TableProps{
		Columns: []*base.TableColumn{
			{Label: pageCtx.T("Sessions.List.User"), Key: "user"},
			{Label: pageCtx.T("Sessions.List.Device"), Key: "device"},
			{Label: pageCtx.T("Sessions.List.IP"), Key: "ip"},
			{Label: pageCtx.T("Sessions.List.CreatedAt"), Key: "createdAt"},
			{Label: pageCtx.T("Actions"), Class: "w-16"},
		},
		TBodyAttrs: templ.Attributes{
			"id": "sessions-table-body",
		},
	}) {
		@SessionRows(props)
	}
}

templ SessionsContent(props *IndexPageProps) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	<div class="bg-surface-600 border border-primary rounded-lg">
		<form
			class="p-4 flex flex-wrap items-center gap-3"
			hx-get={ props.basePath() }
			hx-trigger="keyup[!target.closest('[data-fb-popover]')] changed delay:500ms from:(form input), filter-changed"
			hx-target="#sessions-list"
			hx-swap="outerHTML"
			hx-push-url="true"
			hx-indicator="#sessions-list"
		>
			<input type="hidden" name="page" value="1"/>
			<!-- A chip change keeps the page size the page was opened with. -->
			if props.PerPage > 0 {
				<input type="hidden" name="limit" value={ fmt.Sprint(props.PerPage) }/>
			}
			<div class="flex-1">
				@input.Text(&input.Props{
					AddonLeft: &input.Addon{
						Component: icons.MagnifyingGlass(icons.Props{Size: "20"}),
					},
					Placeholder: pageCtx.T("Sessions.List.Search"),
					Attrs: templ.Attributes{
						"name":  "search",
						"value": props.SearchQuery,
					},
				})
			</div>
			if props.Filters.Registry != nil {
				<div class="w-full">
					@filterbuilder.Builder(props.Filters)
				</div>
			}
		</form>
		@SessionsList(props)
	</div>
}

templ Index(props *IndexPageProps) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	@layouts.Authenticated(layouts.AuthenticatedProps{
		BaseProps: layouts.BaseProps{Title: pageCtx.T("Sessions.Meta.List.Title")},
	}) {
		<div class="m-6">
			<div class="flex justify-between items-center">
				<div class="flex items-center gap-2">
					<h1 class="text-2xl font-medium">
						{ pageCtx.T("Sessions.List.Title") }
					</h1>
					@sdkhelp.Link(sdkhelp.LinkProps{Path: "modules/core-administration.md"})
				</div>
			</div>
			<div class="mt-5">
				<div id="sessions-table-wrapper">
					@SessionsContent(props)
				</div>
			</div>
		</div>
	}
}
