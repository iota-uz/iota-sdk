package account

import (
	"fmt"
	icons "github.com/iota-uz/icons/phosphor"
	"github.com/iota-uz/iota-sdk/components/base/badge"
	"github.com/iota-uz/iota-sdk/components/base/button"
	sdkhelp "github.com/iota-uz/iota-sdk/components/help"
	"github.com/iota-uz/iota-sdk/components/scaffold/filterbuilder"
	corecomponents "github.com/iota-uz/iota-sdk/modules/core/presentation/templates/components"
	"github.com/iota-uz/iota-sdk/modules/core/presentation/viewmodels"
	"github.com/iota-uz/iota-sdk/pkg/composables"
)

type SessionsPageProps struct {
	// Sessions are the sessions matching the chips.
	Sessions     []*viewmodels.Session
	CurrentToken string
	// HasOtherSessions is true when the user has a session besides the
	// current one, whatever the chips show.
	HasOtherSessions bool
	Errors           map[string]string
	// Filters is the filter chip bar; a nil Registry hides it.
	Filters filterbuilder.Props
}

templ sessionIcon(icon string) {
	<div class="flex size-10 shrink-0 items-center justify-center rounded-lg border border-subtle bg-surface-100 text-200">
		switch icon {
			case "device-mobile":
				@icons.DeviceMobile(icons.Props{Size: "22"})
			case "device-tablet":
				@icons.DeviceTablet(icons.Props{Size: "22"})
			default:
				@icons.Desktop(icons.Props{Size: "22"})
		}
	</div>
}

// SessionRow is one signed-in device.
templ SessionRow(session *viewmodels.Session) {
	{{
		pageCtx := composables.UsePageCtx(ctx)
	}}
	<li id={ fmt.Sprintf("session-row-%s", session.TokenID) } class="flex flex-wrap items-center gap-x-4 gap-y-3 px-4 py-4 md:px-6" data-testid="account-session-row">
		@sessionIcon(session.Icon)
		<div class="min-w-0 flex-1">
			<div class="flex flex-wrap items-center gap-2">
				<span class="truncate text-sm font-medium text-100">{ session.Browser }</span>
				if session.IsCurrent {
					@badge.New(badge.Props{
						Class:   templ.Classes("px-2"),
						Variant: badge.VariantGreen,
						Size:    badge.SizeNormal,
					}) {
						{ pageCtx.T("Account.Sessions.CurrentDevice") }
					}
				}
			</div>
			<p class="mt-0.5 truncate text-sm text-200">{ session.OS } · { session.Device }</p>
			<div class="mt-0.5 flex flex-wrap items-baseline gap-x-2 text-xs text-200">
				<span class="whitespace-nowrap"><span class="sr-only">{ pageCtx.T("Account.Sessions.IPAddress") }: </span>{ session.IPAddress }</span>
				<span aria-hidden="true">·</span>
				<span class="whitespace-nowrap [&>div]:inline">
					{ pageCtx.T("Account.Sessions.SignedIn") }&nbsp;
					@corecomponents.LocalDateTime(session.CreatedAtISO)
				</span>
			</div>
		</div>
		if !session.IsCurrent {
			@button.Secondary(button.Props{
				Size:  button.SizeSM,
				Class: "ml-auto min-h-9 text-danger",
				Attrs: templ.Attributes{
					"hx-delete":       fmt.Sprintf("/account/sessions/%s", session.TokenID),
					"hx-confirm":      pageCtx.T("Account.Sessions.ConfirmRevoke"),
					"hx-target":       fmt.Sprintf("#session-row-%s", session.TokenID),
					"hx-swap":         "outerHTML swap:0.3s",
					"hx-disabled-elt": "this",
				},
			}) {
				{ pageCtx.T("Account.Sessions.Revoke") }
			}
		}
	</li>
}

templ SessionsList(props *SessionsPageProps) {
	{{
		pageCtx := composables.UsePageCtx(ctx)
	}}
	<ul class="flex flex-col divide-y divide-subtle border-t border-subtle" role="list" id="sessions-table-body" aria-label={ pageCtx.T("Account.Sessions.Title") }>
		for _, session := range props.Sessions {
			@SessionRow(session)
		}
	</ul>
}

templ EmptyState() {
	{{
		pageCtx := composables.UsePageCtx(ctx)
	}}
	<div class="flex flex-col items-center gap-3 px-4 py-12 text-center">
		@icons.Devices(icons.Props{Size: "40", Class: "text-200"})
		<p class="text-sm font-medium text-100">{ pageCtx.T("Account.Sessions.EmptyState") }</p>
	</div>
}

// NoMatchesState is shown when the chips leave no session.
templ NoMatchesState() {
	{{
		pageCtx := composables.UsePageCtx(ctx)
	}}
	<p class="px-4 py-12 text-center text-sm text-200">
		{ pageCtx.T("Account.Sessions.NoMatches") }
	</p>
}

// SessionsResults is the list part the chips re-render.
templ SessionsResults(props *SessionsPageProps) {
	<div id="account-sessions-results">
		if len(props.Sessions) > 0 {
			@SessionsList(props)
		} else if len(props.Filters.Filters) > 0 {
			@NoMatchesState()
		} else {
			@EmptyState()
		}
	</div>
}

// SessionsListWithChips answers a chip change: the list plus the chip bar,
// swapped out-of-band since it sits in the form above.
templ SessionsListWithChips(props *SessionsPageProps) {
	@SessionsResults(props)
	if props.Filters.Registry != nil {
		@filterbuilder.BuilderOOB(props.Filters)
	}
}

templ revokeOthersButton() {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	@button.Danger(button.Props{
		Size:  button.SizeSM,
		Class: "min-h-9",
		Icon:  icons.SignOut(icons.Props{Size: "18"}),
		Attrs: templ.Attributes{
			"type":            "button",
			"hx-delete":       "/account/sessions/others",
			"hx-confirm":      pageCtx.T("Account.Sessions.ConfirmRevokeAll"),
			"hx-disabled-elt": "this",
			"data-testid":     "account-sessions-revoke-others",
		},
	}) {
		{ pageCtx.T("Account.Sessions.RevokeAll") }
	}
}

// Sessions is the «Sessions» tab: the devices signed in to the account.
templ Sessions(props *SessionsPageProps) {
	{{
		pageCtx := composables.UsePageCtx(ctx)
	}}
	@Section(SectionProps{
		Title:       pageCtx.T("Account.Sessions.Title"),
		Description: pageCtx.T("Account.Sessions.DescText"),
		Aside:       sessionsAside(props.HasOtherSessions),
		BodyCls:     "p-0 pt-4 md:px-0",
		TestID:      "account-sessions",
	}) {
		if props.Filters.Registry != nil {
			<form
				action="/account/sessions"
				method="get"
				class="px-4 pb-3 md:px-6"
				hx-get="/account/sessions"
				hx-trigger="filter-changed"
				hx-target="#account-sessions-results"
				hx-swap="outerHTML"
				hx-push-url="true"
			>
				@filterbuilder.Builder(props.Filters)
			</form>
		}
		@SessionsResults(props)
	}
}

templ sessionsAside(hasOthers bool) {
	<div class="flex items-center gap-3">
		@sdkhelp.Link(sdkhelp.LinkProps{Path: "modules/core-administration.md"})
		if hasOthers {
			@revokeOthersButton()
		}
	</div>
}
