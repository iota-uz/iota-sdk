package settings

import (
	"strings"

	icons "github.com/iota-uz/icons/phosphor"
	"github.com/iota-uz/iota-sdk/components/base/input"
	sdkhelp "github.com/iota-uz/iota-sdk/components/help"
	"github.com/iota-uz/iota-sdk/modules/core/presentation/templates/layouts"
	"github.com/iota-uz/iota-sdk/pkg/composables"
	settingsreg "github.com/iota-uz/iota-sdk/pkg/settings"
)

type HubPageProps struct {
	Sections []settingsreg.ResolvedSection
}

const hubSearchState = `{
	search: '',
	query() { return this.search.trim().toLowerCase() },
	matches(el) { const q = this.query(); return q === '' || el.dataset.search.includes(q) },
	anyMatch(scope) { return Array.from(scope.querySelectorAll('[data-testid="settings-card"]')).some((card) => this.matches(card)) },
}`

func hubCardSearchText(page settingsreg.ResolvedPage) string {
	return strings.ToLower(strings.TrimSpace(page.Name + " " + page.Description))
}

templ Hub(props *HubPageProps) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	@layouts.Authenticated(layouts.AuthenticatedProps{
		BaseProps: layouts.BaseProps{Title: pageCtx.T("Settings.Hub.Title")},
	}) {
		<div class="p-6 md:p-8 max-w-6xl mx-auto" x-data={ hubSearchState } data-testid="settings-hub">
			<div class="flex items-center gap-2 mb-6">
				<h1 class="text-2xl font-semibold text-gray-900">
					{ pageCtx.T("Settings.Hub.Title") }
				</h1>
				@sdkhelp.Link(sdkhelp.LinkProps{Path: "modules/core-administration.md"})
			</div>
			if len(props.Sections) == 0 {
				@hubEmptyState(pageCtx.T("Settings.Hub.Empty.Title"), pageCtx.T("Settings.Hub.Empty.Hint"), "settings-empty", nil)
			} else {
				<div class="flex justify-center mb-8">
					<div class="w-full max-w-md">
						@input.Text(&input.Props{
							Placeholder: pageCtx.T("Settings.Hub.SearchPlaceholder"),
							AddonLeft: &input.Addon{
								Component: icons.MagnifyingGlass(icons.Props{Size: "18"}),
								Class:     "text-gray-400",
							},
							Attrs: templ.Attributes{
								"x-model.debounce.100ms": "search",
								"autocomplete":           "off",
								"aria-label":             pageCtx.T("Settings.Hub.SearchPlaceholder"),
								"data-testid":            "settings-search",
							},
						})
					</div>
				</div>
				for _, section := range props.Sections {
					<section
						class="mb-8"
						data-testid="settings-section"
						data-section-key={ section.Key }
						x-show="anyMatch($el)"
					>
						<h2 class="text-xs font-semibold text-gray-700 uppercase tracking-wider mb-4">
							{ section.Name }
						</h2>
						<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
							for _, page := range section.Pages {
								@hubCard(page)
							}
						</div>
					</section>
				}
				@hubEmptyState(
					pageCtx.T("Settings.Hub.NoResults.Title"),
					pageCtx.T("Settings.Hub.NoResults.Hint"),
					"settings-no-results",
					templ.Attributes{"x-show": "!anyMatch($root)", "x-cloak": true},
				)
			}
		</div>
	}
}

templ hubCard(page settingsreg.ResolvedPage) {
	<a
		href={ templ.SafeURL(page.Href) }
		class="flex items-center gap-4 p-4 bg-surface-300 rounded-xl shadow-sm border border-subtle hover:border-brand hover:shadow-md transition-all group min-w-0"
		data-testid="settings-card"
		data-page-key={ page.Key }
		data-search={ hubCardSearchText(page) }
		x-show="matches($el)"
	>
		<div class="flex items-center justify-center w-10 h-10 shrink-0 rounded-full bg-primary-500/10 text-primary-600">
			if page.Icon != nil {
				@page.Icon
			} else {
				@icons.Gear(icons.Props{Size: "20"})
			}
		</div>
		<div class="min-w-0">
			<div class="text-sm font-medium text-gray-900 group-hover:text-primary-600 truncate">
				{ page.Name }
			</div>
			if page.Description != "" {
				<div class="text-xs text-gray-600 mt-0.5 line-clamp-2">
					{ page.Description }
				</div>
			}
		</div>
	</a>
}

templ hubEmptyState(title, description, testID string, attrs templ.Attributes) {
	<div
		class="flex flex-col items-center justify-center text-center py-16 px-4"
		data-testid={ testID }
		{ attrs... }
	>
		<div class="flex items-center justify-center w-12 h-12 mb-3 rounded-full bg-primary-500/10 text-primary-600">
			@icons.MagnifyingGlass(icons.Props{Size: "22"})
		</div>
		<h2 class="text-base font-medium text-gray-900">{ title }</h2>
		<p class="mt-1 text-sm text-gray-600 max-w-md">{ description }</p>
	</div>
}
