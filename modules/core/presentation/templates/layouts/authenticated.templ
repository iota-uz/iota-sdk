package layouts

import (
	icons "github.com/iota-uz/icons/phosphor"
	"github.com/iota-uz/iota-sdk/components/base"
	"github.com/iota-uz/iota-sdk/components/base/avatar"
	"github.com/iota-uz/iota-sdk/components/base/dialog"
	"github.com/iota-uz/iota-sdk/components/base/toast"
	"github.com/iota-uz/iota-sdk/components/sidebar"
	"github.com/iota-uz/iota-sdk/components/spotlight"
	"github.com/iota-uz/iota-sdk/modules/core/domain/aggregates/notification"
	"github.com/iota-uz/iota-sdk/modules/core/presentation/assets"
	"github.com/iota-uz/iota-sdk/modules/core/presentation/mappers"
	"github.com/iota-uz/iota-sdk/modules/core/services"
	"github.com/iota-uz/iota-sdk/pkg/composables"
	"github.com/iota-uz/iota-sdk/pkg/lens/action"
	"github.com/iota-uz/iota-sdk/pkg/types"
	"net/url"
	"strconv"
)

var (
	navbarOnce = templ.NewOnceHandle()
	themeJs    = "/assets/" + assets.HashFS.HashName("js/theme.js")
)

templ Avatar() {
	{{
		u := mappers.UserToViewModel(composables.MustUseUser(ctx))
		var url string
		if u.Avatar != nil {
			url = u.Avatar.URL
		}
	}}
	<summary class="flex items-center justify-center cursor-pointer" aria-label={ u.Title() }>
		@avatar.Avatar(avatar.Props{
			ImageURL: url,
			Initials: u.Initials(),
		})
	</summary>
}

templ ThemeSwitcher() {
	<div class="flex items-center justify-center relative">
		<input
			class="peer/system appearance-none absolute"
			type="radio"
			name="theme"
			value="system"
			id="theme-system"
			onchange="iotaTheme.onRadioChange(this)"
			checked
		/>
		<label
			for="theme-light"
			class="group/system absolute flex items-center justify-center w-9 h-9 rounded-full bg-gray-200 text-black cursor-pointer invisible peer-checked/system:visible"
		>
			@icons.Desktop(icons.Props{
				Size:  "20",
				Class: "scale-100 transition-transform duration-200",
			})
		</label>
		<input
			class="peer/light appearance-none absolute"
			type="radio"
			name="theme"
			value="light"
			id="theme-light"
			onchange="iotaTheme.onRadioChange(this)"
		/>
		<label
			for="theme-dark"
			class="group/light absolute flex items-center justify-center w-9 h-9 rounded-full bg-gray-200 text-black cursor-pointer invisible peer-checked/light:visible"
		>
			@icons.Sun(icons.Props{
				Size:    "20",
				Variant: icons.Filled,
				Class:   "scale-100 transition-transform duration-200",
			})
		</label>
		<input
			class="peer/dark appearance-none absolute"
			type="radio"
			name="theme"
			value="dark"
			id="theme-dark"
			onchange="iotaTheme.onRadioChange(this)"
		/>
		<label
			for="theme-system"
			class="group/dark absolute flex items-center justify-center w-9 h-9 rounded-full bg-black-950 text-white cursor-pointer invisible peer-checked/dark:visible"
		>
			@icons.Moon(icons.Props{
				Size:       "20",
				Variant:    icons.Filled,
				Class:      "scale-100 transition-transform duration-200",
				Attributes: templ.Attributes{"fill": "currentColor"},
			})
		</label>
	</div>
	@navbarOnce.Once() {
		<script src={ themeJs }></script>
	}
}

templ SidebarTrigger(class string) {
	<button
		x-data
		class={
			"flex items-center justify-center w-9 h-9 rounded-md bg-surface-400 text-black cursor-pointer",
			class,
		}
		@click="$dispatch('open-sidebar')"
	>
		@icons.List(icons.Props{Size: "20"})
	</button>
}

templ Navbar(pageCtx types.PageContext, navbarLeft templ.Component) {
	{{
		browserSessions := services.UseBrowserSessions(ctx)
		nextURL := "/"
		if pageCtx.GetURL() != nil {
			nextURL = pageCtx.GetURL().RequestURI()
		}
	}}
	<section class="h-16 shadow-b-lg border-b w-full flex items-center px-4 md:px-8 bg-surface-300 border-b-primary">
		if navbarLeft != nil {
			@navbarLeft
		}
		<div class="ml-auto flex items-center gap-4 md:gap-8">
			<div class="hidden lg:block">
				@spotlight.Spotlight()
			</div>
			@NotificationBell()
			@ThemeSwitcher()
			@base.DetailsDropdown(&base.DetailsDropdownProps{
				Summary:     Avatar(),
				Classes:     templ.Classes("z-[80]"),
				MenuClasses: templ.Classes("w-72"),
			}) {
				if len(browserSessions) > 0 {
					<li class="pb-1 border-b border-secondary">
						<details
							class="group"
							data-testid="navbar-account-disclosure"
							x-data
							@keydown.escape.stop="$el.removeAttribute('open'); $el.querySelector('[data-testid=navbar-account-disclosure-toggle]').focus()"
						>
							for _, browserSession := range browserSessions {
								if browserSession.Active {
									{{
										account := mappers.UserToViewModel(browserSession.User)
										avatarURL := ""
										if account.Avatar != nil {
											avatarURL = account.Avatar.URL
										}
									}}
									<summary
										class="flex min-h-14 cursor-pointer list-none items-center gap-3 rounded-md p-2 duration-200 hover:bg-surface-400 [&::-webkit-details-marker]:hidden"
										data-testid="navbar-account-disclosure-toggle"
									>
										@avatar.Avatar(avatar.Props{ImageURL: avatarURL, Initials: account.Initials(), Class: templ.Classes("w-10 h-10 text-sm")})
										<span class="min-w-0 flex-1">
											<span class="block truncate font-medium">{ account.Title() }</span>
											<span class="block truncate text-xs text-200">{ account.Email }</span>
										</span>
										<span class="shrink-0 transition-transform duration-200 group-open:rotate-180" aria-hidden="true">
											@icons.CaretDown(icons.Props{Size: "18"})
										</span>
									</summary>
								}
							}
							<ul class="mt-1 flex flex-col gap-1" data-testid="navbar-account-disclosure-panel">
								for _, browserSession := range browserSessions {
									if browserSession.Session.IsActive() && !browserSession.Active {
										{{
											account := mappers.UserToViewModel(browserSession.User)
											avatarURL := ""
											if account.Avatar != nil {
												avatarURL = account.Avatar.URL
											}
										}}
										@base.DropdownFormItem(base.DropdownFormItemProps{
											Action: "/login/session?next=" + url.QueryEscape(nextURL),
											Method: "post",
											Fields: map[string]string{"SessionReference": browserSession.Reference()},
										}) {
											<span class="flex items-center gap-3" data-testid="navbar-account-switch">
												@avatar.Avatar(avatar.Props{ImageURL: avatarURL, Initials: account.Initials(), Class: templ.Classes("w-8 h-8 text-xs")})
												<span class="min-w-0 flex-1">
													<span class="block truncate font-medium">{ account.Title() }</span>
													<span class="block truncate text-xs text-200">{ account.Email }</span>
												</span>
												<span class="shrink-0 text-200" aria-hidden="true">
													@icons.SignIn(icons.Props{Size: "18"})
												</span>
											</span>
										}
									}
								}
								@base.DropdownItem(base.DropdownItemProps{Href: "/login?next=" + url.QueryEscape(nextURL) + "#login-methods"}) {
									<span class="flex items-center gap-3" data-testid="navbar-add-account">
										<span class="text-200" aria-hidden="true">
											@icons.PlusCircle(icons.Props{Size: "20"})
										</span>
										{ pageCtx.T("NavigationLinks.Navbar.AddAccount") }
									</span>
								}
								@base.DropdownFormItem(base.DropdownFormItemProps{Action: "/logout/all", Method: "post"}) {
									<span class="flex items-center gap-3" data-testid="navbar-logout-all">
										<span class="text-200" aria-hidden="true">
											@icons.SignOut(icons.Props{Size: "20"})
										</span>
										{ pageCtx.T("NavigationLinks.Navbar.LogoutAll") }
									</span>
								}
							</ul>
						</details>
					</li>
				}
				@base.DropdownItem(base.DropdownItemProps{Href: "/account"}) {
					{ pageCtx.T("NavigationLinks.Navbar.Profile") }
				}
				@base.DropdownItem(base.DropdownItemProps{Href: "/account/sessions"}) {
					{ pageCtx.T("NavigationLinks.Navbar.Sessions") }
				}
				@base.DropdownItem(base.DropdownItemProps{Href: "/settings"}) {
					{ pageCtx.T("NavigationLinks.Navbar.Settings") }
				}
				@base.DropdownFormItem(base.DropdownFormItemProps{Action: "/logout", Method: "post"}) {
					<span class="flex items-center gap-3" data-testid="navbar-logout-current">
						<span class="text-200" aria-hidden="true">
							@icons.SignOut(icons.Props{Size: "20"})
						</span>
						{ pageCtx.T("NavigationLinks.Navbar.LogoutCurrent") }
					</span>
				}
			}
			@SidebarTrigger("lg:hidden")
		</div>
	</section>
}

templ DefaultSidebarFooter() {
	@SidebarFooter()
}

templ SidebarFooter() {
	<!-- Toggle button at bottom -->
	<button
		@click.stop="toggle(); $dispatch('sidebar-toggle')"
		class="hidden lg:flex items-center justify-center w-full p-2 text-gray-400 hover:text-gray-600 hover:bg-gray-100 rounded-md transition-colors"
	>
		<div x-show="!isCollapsed">
			@icons.CaretDoubleLeft(icons.Props{Size: "20"})
		</div>
		<div x-show="isCollapsed">
			@icons.CaretDoubleRight(icons.Props{Size: "20"})
		</div>
	</button>
	{ children... }
}

templ MobileSidebar(props sidebar.Props) {
	@dialog.Drawer(dialog.DrawerProps{
		Direction: dialog.LTR,
		Action:    "open-sidebar",
	}) {
		<div class="w-3/4 sm:w-2/3">
			@sidebar.Sidebar(props)
		</div>
	}
}

templ DefaultSidebarHeader() {
	<div class="flex flex-col items-center justify-center space-y-4">
		<a href="/" class="flex items-center gap-2">
			@MustUseLogo(ctx)
		</a>
	</div>
}

type AuthenticatedProps struct {
	BaseProps
	NavbarLeft templ.Component
}

templ Authenticated(props AuthenticatedProps) {
	{{
		pageCtx := composables.UsePageCtx(ctx)
		sidebarProps := MustUseSidebarProps(ctx)
	}}
	{{if props.WebsocketURL == "" {
	props.WebsocketURL = "/ws"
}
	}}
	@Base(&props.BaseProps) {
		@toast.Container()
		@MobileSidebar(sidebarProps)
		<div
			x-data="{
				sidebarCollapsed: initSidebarCollapsed(),
				init() {
					this.$nextTick(() => {
						// Listen for storage changes from other tabs
						window.addEventListener('storage', (e) => {
							if (e.key === 'sidebar-collapsed') {
								this.sidebarCollapsed = e.newValue === 'true';
							}
						});
					});
				}
			}"
			data-sidebar-state={ string(sidebarProps.InitialState) }
			@sidebar-toggle="sidebarCollapsed = !sidebarCollapsed"
			class="flex min-h-screen sdk-min-h-dvh w-full"
		>
			<div class="hidden lg:block flex-shrink-0">
				@sidebar.Sidebar(sidebarProps)
			</div>
			<div class="flex-1 flex flex-col h-screen sdk-h-dvh overflow-hidden">
				@Navbar(pageCtx, props.NavbarLeft)
				<div class="flex-1 overflow-y-auto content">
					{ children... }
				</div>
			</div>
		</div>
	}
}

templ NotificationBell() {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	<details class="relative" data-testid="notification-bell" x-data @keydown.escape.stop="$el.removeAttribute('open')">
		<summary class="relative flex items-center justify-center w-9 h-9 rounded-md hover:bg-surface-400 cursor-pointer list-none" aria-label={ pageCtx.T("Notifications.Title") }>
			@icons.Bell(icons.Props{Size: "22"})
			<span id="notification-bell-count" hx-get="/notifications/summary" hx-trigger="notificationsChanged from:body" hx-swap="innerHTML" aria-live="polite">
				@NotificationBellCount(services.NotificationUnreadCount(ctx))
			</span>
		</summary>
		<div class="absolute right-0 mt-2 z-[80] w-80 max-h-[70vh] overflow-y-auto rounded-lg border border-secondary bg-surface-300 shadow-lg" id="notification-dropdown" hx-get="/notifications/dropdown" hx-trigger="load, notificationsChanged from:body" hx-swap="innerHTML"></div>
	</details>
	<script>
 if (!window.iotaNotificationRealtimeInstalled) {
 window.iotaNotificationRealtimeInstalled = true;
 document.addEventListener("htmx:wsBeforeMessage",function(event){
 let message;try{message=JSON.parse(event.detail.message)}catch{return}
 if(message.type!=="notification.changed")return;
 event.preventDefault();document.body.dispatchEvent(new CustomEvent("notificationsChanged",{bubbles:true}));
 const n=message.notification;if(n){window.dispatchEvent(new CustomEvent("notify",{detail:{title:n.title,message:n.body,variant:n.level||"info"}}));}
 });
 document.addEventListener("htmx:wsOpen",function(){document.body.dispatchEvent(new CustomEvent("notificationsChanged",{bubbles:true}));});
 }
 </script>
}

templ NotificationBellCount(count int64) {
	if count > 0 {
		<span class="absolute -right-2 -top-1 rounded-full bg-primary text-white text-xs min-w-5 px-1 text-center" data-testid="notification-unread-count">{ strconv.FormatInt(count,10) }</span>
	}
}

templ NotificationDropdown(items []notification.Notification, count int64) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	<div class="p-3 border-b border-secondary flex justify-between items-center"><a href="/notifications" class="font-semibold text-primary">{ pageCtx.T("Notifications.Title") }</a><form method="post" action="/notifications/read-all" hx-post="/notifications/read-all" hx-swap="none"><button type="submit" disabled?={ count==0 } class="text-xs text-primary disabled:opacity-50">{ pageCtx.T("Notifications.MarkAllRead") }</button></form></div>
	if len(items)==0 {
		<p class="p-4 text-sm text-200">{ pageCtx.T("Notifications.Empty") }</p>
	}
	<ul>
		for _,n := range items {
			<li class={ "p-3 border-b border-secondary",templ.KV("bg-surface-400",n.ReadAt()==nil) } data-testid="notification-dropdown-item">
				<p class="font-medium break-words">{ n.Title() }</p>
				<p class="text-sm text-200 whitespace-pre-wrap break-words">{ n.Body() }</p>
				<div class="flex gap-3 mt-2">
					if safe,ok:=action.SafeRelativeURL(n.ActionURL());ok {
						<a href={ templ.URL(safe) } class="text-xs text-primary">{ pageCtx.T("Notifications.Open") }</a>
					}
					if n.ReadAt()==nil {
						<form method="post" action={ templ.URL("/notifications/" + n.ID().String() + "/read") } hx-post={ "/notifications/" + n.ID().String() + "/read" } hx-swap="none"><button type="submit" class="text-xs text-primary">{ pageCtx.T("Notifications.MarkRead") }</button></form>
					}
				</div>
			</li>
		}
	</ul>
}
