package components

import (
	"context"

	"github.com/iota-uz/iota-sdk/components/base"
	"github.com/iota-uz/iota-sdk/modules/core/presentation/viewmodels"
	"github.com/iota-uz/iota-sdk/pkg/intl"
)

type CurrencySelectProps struct {
	Label       string
	Placeholder string
	Value       string
	Error       string
	Currencies  []*viewmodels.Currency
	Attrs       templ.Attributes
}

// CurrencyName returns the localized currency name (Currencies.<CODE>) and falls
// back to the stored name for codes without a translation.
func CurrencyName(ctx context.Context, currency *viewmodels.Currency) string {
	return intl.TWithDefault(ctx, "Currencies."+currency.Code, currency.Name)
}

templ CurrencySelect(props *CurrencySelectProps) {
	@base.Select(&base.SelectProps{
		Label:       props.Label,
		Placeholder: props.Placeholder,
		Attrs:       props.Attrs,
		Error:       props.Error,
	}) {
		for _, currency := range props.Currencies {
			if currency.Code == props.Value {
				<option value={ currency.Code } selected>
					{ currency.Symbol }
					{ CurrencyName(ctx, currency) }
				</option>
			} else {
				<option value={ currency.Code }>
					{ currency.Symbol }
					{ CurrencyName(ctx, currency) }
				</option>
			}
		}
	}
}
