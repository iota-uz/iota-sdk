package employees

import (
	icons "github.com/iota-uz/icons/phosphor"
	"github.com/iota-uz/iota-sdk/components/base/badge"
	"github.com/iota-uz/iota-sdk/components/base/input"
	"github.com/iota-uz/iota-sdk/modules/hrm/domain/aggregates/employee"
	"github.com/iota-uz/iota-sdk/modules/hrm/presentation/viewmodels"
	"github.com/iota-uz/iota-sdk/pkg/composables"
	"github.com/iota-uz/iota-sdk/pkg/types"
)

type SharedProps struct {
	types.PageContext
	Employee *viewmodels.Employee
	Errors   map[string]string
	// Form binds the inputs to a form they are rendered outside of.
	Form string
}

func (p SharedProps) attrs(name, value string) templ.Attributes {
	attrs := templ.Attributes{"name": name, "value": value}
	if p.Form != "" {
		attrs["form"] = p.Form
	}
	return attrs
}

func statusVariant(status string) badge.Variant {
	if status == string(employee.StatusFormer) {
		return badge.VariantGray
	}
	return badge.VariantGreen
}

templ StatusBadge(status string) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	@badge.New(badge.Props{Variant: statusVariant(status), Class: templ.Classes("px-3 w-fit")}) {
		{ pageCtx.T("Employees.Status." + status) }
	}
}

templ SalaryInput(props SharedProps) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	@input.Number(&input.Props{
		Label: pageCtx.T("Employees.Private.Salary.Label"),
		Error: props.Errors["Salary"],
		Attrs: props.attrs("Salary", props.Employee.Salary),
		AddonRight: &input.Addon{
			Component: icons.Money(icons.Props{
				Size:  "18",
				Class: "text-gray-400",
			}),
		},
	})
}

templ TinInput(props SharedProps) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	@input.Text(&input.Props{
		Label:       pageCtx.T("Employees.Private.TIN.Label"),
		Placeholder: pageCtx.T("Employees.Private.TIN.Placeholder"),
		Error:       props.Errors["Tin"],
		Attrs:       props.attrs("Tin", props.Employee.Tin),
	})
}

