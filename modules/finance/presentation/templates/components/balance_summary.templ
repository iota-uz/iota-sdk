package components

import (
	"github.com/iota-uz/iota-sdk/modules/finance/presentation/viewmodels"
	"github.com/iota-uz/iota-sdk/pkg/composables"
)

// BalanceSummary shows, per currency, what is on the accounts, what open
// payable debts have reserved of it and what is available to spend.
templ BalanceSummary(balances []*viewmodels.Balance) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	if len(balances) > 0 {
		<div class="flex flex-col gap-3">
			for _, balance := range balances {
				<dl class="grid grid-cols-1 sm:grid-cols-3 gap-3">
					@balanceFigure(pageCtx.T("Finance.Balances.OnAccounts"), balance.OnAccounts, false)
					@balanceFigure(pageCtx.T("Finance.Balances.Reserved"), balance.Reserved, false)
					@balanceFigure(pageCtx.T("Finance.Balances.Available"), balance.Available, balance.Overdrawn)
				</dl>
			}
		</div>
	}
}

templ balanceFigure(label, amount string, negative bool) {
	<div class="bg-surface-600 border border-primary rounded-lg px-4 py-3">
		<dt class="text-sm text-200">{ label }</dt>
		<dd class={ "text-xl font-medium tabular-nums", templ.KV("text-red-500", negative) }>{ amount }</dd>
	</div>
}

type AccountBalanceProps struct {
	Balance *viewmodels.Balance
	// Reserves are the open obligations paid from the account; nil when the
	// user cannot read debts, and then only the balance on the account shows.
	Reserves []*viewmodels.Debt
}

// AccountBalance shows one account's balance split the same way as
// BalanceSummary, followed by the obligations that reserve it.
templ AccountBalance(props AccountBalanceProps) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	<div class="flex flex-col gap-4">
		if props.Reserves == nil {
			<dl class="grid grid-cols-1 gap-3">
				@balanceFigure(pageCtx.T("Finance.Balances.OnAccounts"), props.Balance.OnAccounts, false)
			</dl>
		} else {
			@BalanceSummary([]*viewmodels.Balance{props.Balance})
		}
		if len(props.Reserves) > 0 {
			<section class="flex flex-col gap-2">
				<h3 class="text-sm font-medium text-200">{ pageCtx.T("Finance.Balances.Reserves") }</h3>
				for _, reserve := range props.Reserves {
					<button
						type="button"
						class="w-full text-left bg-surface-600 border border-primary rounded-lg px-4 py-3 flex items-center justify-between gap-3 hover:bg-surface-500"
						hx-get={ "/finance/debts/" + reserve.ID + "/drawer" }
						hx-target="#view-drawer"
						hx-swap="innerHTML"
					>
						<div class="min-w-0">
							<p class="text-sm font-medium truncate">{ reserve.CounterpartyName }</p>
							<p class="text-xs text-200 flex gap-2 min-w-0">
								if reserve.DueDate != "" {
									<span class="whitespace-nowrap">{ pageCtx.T("Debts.Single.DueDate") }: { reserve.DueDate }</span>
								}
								<span class="truncate">{ reserve.Description }</span>
							</p>
						</div>
						<span class="text-sm font-medium tabular-nums whitespace-nowrap">{ reserve.OutstandingAmountWithCurrency }</span>
					</button>
				}
			</section>
		}
	</div>
}
