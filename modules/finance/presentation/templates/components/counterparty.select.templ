package components

import (
	"github.com/iota-uz/iota-sdk/components/base"
	"github.com/iota-uz/iota-sdk/modules/finance/presentation/viewmodels"
)

type CounterpartySelectProps struct {
	Label          string
	Placeholder    string
	Value          string
	Name           string
	NotFoundText   string
	Form           string
	Error          string
	Counterparties []*viewmodels.Counterparty
}

// selectedCounterpartyName returns the name to show for the chosen counterparty.
// The options come from the search endpoint, so the chosen one is rendered
// here: without its name the picker shows an empty value.
func selectedCounterpartyName(props *CounterpartySelectProps) string {
	for _, counterparty := range props.Counterparties {
		if counterparty.ID == props.Value {
			return counterparty.Name
		}
	}
	return ""
}

templ CounterpartySelect(props *CounterpartySelectProps) {
	@base.Combobox(base.ComboboxProps{
		Label:        props.Label,
		Placeholder:  props.Placeholder,
		Searchable:   true,
		NotFoundText: props.NotFoundText,
		Name:         props.Name,
		Endpoint:     "/finance/counterparties/search",
		Form:         props.Form,
	}) {
		if props.Value != "" {
			<option value={ props.Value } selected>{ selectedCounterpartyName(props) }</option>
		}
	}
	if props.Error != "" {
		<small class="text-xs text-red-500 -mt-3" data-testid="field-error">{ props.Error }</small>
	}
}
