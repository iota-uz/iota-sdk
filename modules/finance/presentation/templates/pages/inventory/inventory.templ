package inventory

import (
	"fmt"
	icons "github.com/iota-uz/icons/phosphor"
	"github.com/iota-uz/iota-sdk/components/base"
	"github.com/iota-uz/iota-sdk/components/base/button"
	"github.com/iota-uz/iota-sdk/components/base/pagination"
	"github.com/iota-uz/iota-sdk/components/filters"
	sdkhelp "github.com/iota-uz/iota-sdk/components/help"
	"github.com/iota-uz/iota-sdk/components/scaffold/filterbuilder"
	"github.com/iota-uz/iota-sdk/modules/core/presentation/templates/layouts"
	"github.com/iota-uz/iota-sdk/modules/finance/presentation/viewmodels"
	"github.com/iota-uz/iota-sdk/pkg/composables"
)

type IndexPageProps struct {
	Inventory       []*viewmodels.Inventory
	PaginationState *pagination.State
	// Filters is the filter chip bar; a nil Registry hides it.
	Filters filterbuilder.Props
}

// InventoryTableWithChips answers a search or filter change: the table plus
// the chip bar, swapped out-of-band since it sits in the form above.
templ InventoryTableWithChips(props *IndexPageProps) {
	@InventoryTable(props)
	if props.Filters.Registry != nil {
		@filterbuilder.BuilderOOB(props.Filters)
	}
}

templ InventoryTable(props *IndexPageProps) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	<div class="flex flex-col gap-4 table-wrapper">
		if len(props.Inventory) == 0 {
			@base.TableEmptyState(base.TableEmptyStateProps{
				Title:       pageCtx.T("Inventory.List.NoInventory.Title"),
				Description: pageCtx.T("Inventory.List.NoInventory._Description"),
			})
		} else {
			@base.Table(base.TableProps{
				Columns: []*base.TableColumn{
					{Label: pageCtx.T("Inventory.List.Name"), Key: "name"},
					{Label: pageCtx.T("Inventory.List.Price"), Key: "price"},
					{Label: pageCtx.T("Inventory.List.Quantity"), Key: "quantity"},
					{Label: pageCtx.T("Inventory.List.TotalValue"), Key: "totalValue"},
					{Label: pageCtx.T("UpdatedAt"), Key: "updatedAt"},
					{Label: pageCtx.T("Actions"), Class: "w-16"},
				},
			}) {
				for _, item := range props.Inventory {
					@base.TableRow(base.TableRowProps{}) {
						@base.TableCell(base.TableCellProps{}) {
							{ item.Name }
						}
						@base.TableCell(base.TableCellProps{}) {
							{ item.Price } { item.CurrencyCode }
						}
						@base.TableCell(base.TableCellProps{}) {
							{ item.Quantity }
						}
						@base.TableCell(base.TableCellProps{}) {
							{ item.TotalValue } { item.CurrencyCode }
						}
						@base.TableCell(base.TableCellProps{}) {
							<div x-data="relativeformat">
								<span x-text={ fmt.Sprintf("format('%s')", item.UpdatedAt) }></span>
							</div>
						}
						@base.TableCell(base.TableCellProps{}) {
							@button.Secondary(button.Props{
								Fixed: true,
								Size:  button.SizeSM,
								Class: "btn-fixed",
								Href:  fmt.Sprintf("/finance/inventory/%s", item.ID),
							}) {
								@icons.PencilSimple(icons.Props{Size: "20"})
							}
						}
					}
				}
			}
			if props.PaginationState != nil && len(props.PaginationState.Pages()) > 1 {
				@pagination.Pagination(props.PaginationState)
			}
		}
	</div>
}

templ InventoryContent(props *IndexPageProps) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	<div class="m-6">
		<div class="flex items-center gap-2">
			<h1 class="text-2xl font-medium">
				{ pageCtx.T("NavigationLinks.Inventory") }
			</h1>
			@sdkhelp.Link(sdkhelp.LinkProps{Path: "modules/finance.md"})
		</div>
		<div class="mt-5 bg-surface-600 border border-primary rounded-lg">
			<form
				class="p-4 flex flex-wrap items-center gap-3 [&>div]:min-w-0"
				hx-get="/finance/inventory"
				hx-trigger="keyup[!target.closest('[data-fb-popover]')] changed delay:500ms from:(form input), change[!target.closest('[data-fb-popover]')] changed from:(form select), filter-changed"
				hx-target=".table-wrapper"
				hx-swap="outerHTML"
				hx-push-url="true"
			>
				<div class="w-full md:flex-1">
					@filters.Search([]filters.SearchField{
						{
							Label: pageCtx.T("Inventory.List.Name"),
							Key:   "name",
						},
					})
				</div>
				@filters.PageSize()
				@button.Primary(button.Props{
					Size: button.SizeNormal, Href: "/finance/inventory/new",
					Icon: icons.PlusCircle(icons.Props{Size: "18"}),
				}) {
					{ pageCtx.T("Inventory.List.New") }
				}
				if props.Filters.Registry != nil {
					<div class="w-full">
						@filterbuilder.Builder(props.Filters)
					</div>
				}
			</form>
			@InventoryTable(props)
		</div>
	</div>
}

templ Index(props *IndexPageProps) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	@layouts.Authenticated(layouts.AuthenticatedProps{
		BaseProps: layouts.BaseProps{Title: pageCtx.T("Inventory.Meta.List.Title")},
	}) {
		@InventoryContent(props)
	}
}
