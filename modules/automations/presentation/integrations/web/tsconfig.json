{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@iota-uz/sdk/solid": ["../../../../../web/client-host/src/solid-index.ts"],
      "@iota-uz/sdk/solid-ui": ["../../../../../web/solid-ui/src/index.ts"],
      "solid-js": ["./node_modules/solid-js"],
      "solid-js/*": ["./node_modules/solid-js/*"]
    }
  },
  "include": ["*.ts", "*.tsx", "fixtures", "browser-tests"]
}
