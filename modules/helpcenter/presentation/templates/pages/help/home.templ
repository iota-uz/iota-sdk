package help

import (
	icons "github.com/iota-uz/icons/phosphor"
	"github.com/iota-uz/iota-sdk/modules/helpcenter/presentation/viewmodels"
	"github.com/iota-uz/iota-sdk/pkg/composables"
)

type HomeProps struct {
	BasePath string
	Groups   []viewmodels.TaskGroup
}

templ Home(props HomeProps) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	<div class="help-home">
		<header class="help-home-intro">
			<div class="help-home-kicker">
				<span>{ pageCtx.T("HelpCenter.Tasks.Kicker") }</span>
			</div>
			<h1>{ pageCtx.T("HelpCenter.Tasks.Title") }</h1>
			<p class="help-home-lead">{ pageCtx.T("HelpCenter.Tasks.Subtitle") }</p>
			<div class="help-home-path" aria-label={ pageCtx.T("HelpCenter.Tasks.PathLabel") }>
				for i, step := range []string{"Task", "Screen", "Result"} {
					<div>
						<small>{ pageCtx.T("HelpCenter.Tasks.Step", map[string]interface{}{"N": i + 1}) }</small>
						{ pageCtx.T("HelpCenter.Tasks.Path." + step) }
					</div>
				}
			</div>
		</header>
		<div class="help-task-groups">
			for _, group := range props.Groups {
				<section>
					<h2 class="help-task-group-heading">
						{ group.Title }
						<small>{ guideCountLabel(ctx, len(group.Tasks)) }</small>
					</h2>
					<div class="help-task-grid">
						for _, task := range group.Tasks {
							@taskCard(props.BasePath, task)
						}
					</div>
				</section>
			}
		</div>
	</div>
}

templ taskCard(basePath string, task viewmodels.HelpTask) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	<article class="help-task-card">
		if task.ArticlePath != "" {
			<div class="help-task-meta">
				<span>{ pageCtx.T("HelpCenter.Tasks.Guide") }</span>
				if task.ReadingMinutes > 0 {
					<span>{ minutesLabel(ctx, task.ReadingMinutes) }</span>
				}
			</div>
		}
		<h3 class="help-task-title">
			if task.ArticlePath != "" {
				<a
					class="help-task-link"
					href={ templ.URL(basePath + "/doc/" + task.ArticlePath) }
					hx-get={ basePath + "/doc/" + task.ArticlePath }
					hx-target="#help-doc-pane"
					hx-push-url="true"
				>{ task.Title }</a>
			} else if task.ScreenPath != "" {
				<a class="help-task-link" href={ templ.URL(task.ScreenPath) }>{ task.Title }</a>
			} else {
				{ task.Title }
			}
		</h3>
		<p class="help-task-description">{ task.Description }</p>
		if task.Outcome != "" {
			<div class="help-task-outcome">
				@icons.CheckCircle(icons.Props{Size: "15", Variant: icons.DuoTone})
				<span>{ task.Outcome }</span>
			</div>
		}
		<div class="help-task-actions">
			if task.ArticlePath != "" {
				<span class="help-task-action help-task-action-primary">
					{ pageCtx.T("HelpCenter.Tasks.ReadGuide") }
					@icons.ArrowRight(icons.Props{Size: "13"})
				</span>
			}
			if task.ArticlePath != "" && task.ScreenPath != "" {
				<a class="help-task-action help-task-action-secondary" href={ templ.URL(task.ScreenPath) }>
					{ pageCtx.T("HelpCenter.Tasks.OpenScreen") } ↗
				</a>
			}
		</div>
	</article>
}
