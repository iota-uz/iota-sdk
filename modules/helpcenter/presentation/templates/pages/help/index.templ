package help

import (
	"strings"

	icons "github.com/iota-uz/icons/phosphor"
	sdkhelp "github.com/iota-uz/iota-sdk/components/help"
	"github.com/iota-uz/iota-sdk/modules/core/presentation/templates/layouts"
	"github.com/iota-uz/iota-sdk/modules/helpcenter/presentation/assets"
	"github.com/iota-uz/iota-sdk/modules/helpcenter/presentation/viewmodels"
	"github.com/iota-uz/iota-sdk/pkg/composables"
)

var mermaidJS = "/assets/" + assets.HashFS.HashName("js/lib/mermaid-11.12.2.min.js")
var helpCenterCSS = "/assets/" + assets.HashFS.HashName("css/help-center.css")

type IndexProps struct {
	BasePath        string
	Tree            []viewmodels.CategoryNode
	Tasks           []viewmodels.TaskGroup
	Doc             *viewmodels.DocView
	SearchAvailable bool
	Locale          string
	FeedbackURL     string
}

func activePageValue(active *viewmodels.DocView, path string) string {
	if active != nil && active.Path == path {
		return "page"
	}
	return "false"
}

func categoryContainsActive(node viewmodels.CategoryNode, active *viewmodels.DocView) bool {
	if active == nil {
		return false
	}
	if node.Path == active.Path {
		return true
	}
	for _, child := range node.Children {
		if categoryContainsActive(child, active) {
			return true
		}
	}
	return false
}

func categoryDisplayTitle(title string) string {
	title = strings.TrimSpace(title)
	prefix, remainder, found := strings.Cut(title, " ")
	if found && len(prefix) == 2 && prefix[0] >= '0' && prefix[0] <= '9' && prefix[1] >= '0' && prefix[1] <= '9' {
		return strings.TrimSpace(remainder)
	}
	return title
}

templ Index(props IndexProps) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	@layouts.Authenticated(layouts.AuthenticatedProps{
		BaseProps: layouts.BaseProps{Title: pageCtx.T("HelpCenter.Meta.Title")},
	}) {
		<link rel="stylesheet" href={ helpCenterCSS }/>
		<div
			id="help-center-shell"
			class="help-shell"
			data-sidebar-collapsed="false"
			data-mobile-sidebar-open="false"
			data-copy-label={ pageCtx.T("HelpCenter.CopyCode") }
			data-copied-label={ pageCtx.T("HelpCenter.Copied") }
			data-diagram-label={ pageCtx.T("HelpCenter.Diagram.Label") }
			data-diagram-zoom-in-label={ pageCtx.T("HelpCenter.Diagram.ZoomIn") }
			data-diagram-zoom-out-label={ pageCtx.T("HelpCenter.Diagram.ZoomOut") }
			data-diagram-reset-zoom-label={ pageCtx.T("HelpCenter.Diagram.ResetZoom") }
			data-diagram-zoom-level-label={ pageCtx.T("HelpCenter.Diagram.ZoomLevel") }
			data-diagram-enter-fullscreen-label={ pageCtx.T("HelpCenter.Diagram.EnterFullscreen") }
			data-diagram-exit-fullscreen-label={ pageCtx.T("HelpCenter.Diagram.ExitFullscreen") }
			data-expand-navigation-label={ pageCtx.T("HelpCenter.ExpandNavigation") }
			data-collapse-navigation-label={ pageCtx.T("HelpCenter.CollapseNavigation") }
			data-close-navigation-label={ pageCtx.T("HelpCenter.CloseNavigation") }
			data-note-label={ pageCtx.T("HelpCenter.Callouts.Note") }
			data-tip-label={ pageCtx.T("HelpCenter.Callouts.Tip") }
			data-important-label={ pageCtx.T("HelpCenter.Callouts.Important") }
			data-warning-label={ pageCtx.T("HelpCenter.Callouts.Warning") }
			data-caution-label={ pageCtx.T("HelpCenter.Callouts.Caution") }
			data-link-copied-label={ pageCtx.T("HelpCenter.Toc.LinkCopied") }
		>
			<header class="help-topbar">
				<div class="help-brand">
					<button
						id="help-sidebar-toggle"
						type="button"
						class="help-sidebar-toggle"
						aria-controls="help-library"
						aria-expanded="true"
						aria-label={ pageCtx.T("HelpCenter.CollapseNavigation") }
						title={ pageCtx.T("HelpCenter.CollapseNavigation") }
					>
						<span class="help-icon-collapse">
							@icons.CaretDoubleLeft(icons.Props{Size: "17"})
						</span>
						<span class="help-icon-expand">
							@icons.CaretDoubleRight(icons.Props{Size: "17"})
						</span>
					</button>
					<a
						class="help-brand-mark"
						href={ templ.URL(props.BasePath) }
						aria-label={ pageCtx.T("HelpCenter.Tasks.Title") }
						title={ pageCtx.T("HelpCenter.Tasks.Title") }
					>
						@icons.FileText(icons.Props{Size: "18", Variant: icons.DuoTone})
					</a>
					<div class="help-brand-copy">
						<div class="help-brand-title">
							<span>{ pageCtx.T("HelpCenter.Meta.Title") }</span>
							@sdkhelp.Link(sdkhelp.LinkProps{Path: "modules/help-center.md"})
						</div>
						<div class="help-brand-subtitle">{ pageCtx.T("HelpCenter.Meta.Subtitle") }</div>
					</div>
				</div>
				<form class="help-search" hx-get={ props.BasePath + "/search" } hx-target="#help-search-results" hx-trigger="submit">
					<div class="absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none">
						@icons.MagnifyingGlass(icons.Props{Size: "17"})
					</div>
					<input
						type="search"
						name="q"
						placeholder={ pageCtx.T("HelpCenter.Search.Placeholder") }
						disabled?={ !props.SearchAvailable }
						hx-get={ props.BasePath + "/search" }
						hx-target="#help-search-results"
						hx-trigger="input changed delay:250ms, search"
						hx-indicator="#help-search-spinner"
						autocomplete="off"
						class="help-search-input"
					/>
					<div id="help-search-spinner" class="htmx-indicator absolute right-3 top-1/2 -translate-y-1/2 text-gray-400">
						@icons.CircleNotch(icons.Props{Size: "16", Class: "animate-spin"})
					</div>
					if props.SearchAvailable {
						<kbd class="help-search-kbd">⌘ K</kbd>
					}
					<div id="help-search-results" class="absolute left-0 right-0 top-full z-50 mt-2"></div>
				</form>
				<nav class="help-topbar-links" aria-label={ pageCtx.T("HelpCenter.TopbarLinks.Label") }>
					<a href={ templ.URL(props.BasePath) }>{ pageCtx.T("HelpCenter.TopbarLinks.AllSections") }</a>
					if props.FeedbackURL != "" {
						<a href={ templ.URL(props.FeedbackURL) } target="_blank" rel="noopener noreferrer">{ pageCtx.T("HelpCenter.TopbarLinks.Feedback") }</a>
					}
				</nav>
			</header>
			<div class="help-workspace">
				<aside id="help-library" class="help-library" aria-label={ pageCtx.T("HelpCenter.Categories") }>
					<div class="help-library-scroll">
						<div class="help-library-heading">
							<span>{ pageCtx.T("HelpCenter.Categories") }</span>
							<button id="help-sidebar-close" type="button" class="help-sidebar-close" aria-label={ pageCtx.T("HelpCenter.CloseNavigation") }>
								@icons.X(icons.Props{Size: "16"})
							</button>
						</div>
						<nav>
							for _, node := range props.Tree {
								@categoryNode(props.BasePath, node, props.Doc)
							}
						</nav>
					</div>
				</aside>
				<button id="help-mobile-overlay" type="button" class="help-mobile-overlay" aria-label={ pageCtx.T("HelpCenter.CloseNavigation") }></button>
				<main class="help-main">
					<div id="help-doc-pane">
						if props.Doc != nil {
							@Doc(DocProps{BasePath: props.BasePath, Doc: props.Doc})
						} else if len(props.Tasks) > 0 {
							@Home(HomeProps{BasePath: props.BasePath, Groups: props.Tasks})
						} else {
							<div class="p-6 text-sm text-gray-500">{ pageCtx.T("HelpCenter.Empty") }</div>
						}
					</div>
				</main>
			</div>
		</div>
		<script src={ mermaidJS }></script>
		<script>
			(() => {
				const shell = document.getElementById("help-center-shell");
				if (!shell) return;

				const storageKey = "iota-help-sidebar-collapsed";
				const sidebarToggle = document.getElementById("help-sidebar-toggle");
				const sidebarClose = document.getElementById("help-sidebar-close");
				const mobileOverlay = document.getElementById("help-mobile-overlay");
				const mobileQuery = window.matchMedia("(max-width: 1023px)");

				const setSidebarCollapsed = (collapsed) => {
					shell.dataset.sidebarCollapsed = String(collapsed);
					sidebarToggle?.setAttribute("aria-expanded", String(!collapsed));
					const label = collapsed
						? shell.dataset.expandNavigationLabel
						: shell.dataset.collapseNavigationLabel;
					sidebarToggle?.setAttribute("aria-label", label);
					sidebarToggle?.setAttribute("title", label);
					try {
						localStorage.setItem(storageKey, String(collapsed));
					} catch (_) {}
				};

				const setMobileSidebarOpen = (open) => {
					shell.dataset.mobileSidebarOpen = String(open);
					sidebarToggle?.setAttribute("aria-expanded", String(open));
					const label = open
						? shell.dataset.closeNavigationLabel
						: shell.dataset.expandNavigationLabel;
					sidebarToggle?.setAttribute("aria-label", label);
					sidebarToggle?.setAttribute("title", label);
				};

				const closeMobileSidebar = () => {
					if (!mobileQuery.matches) return;
					setMobileSidebarOpen(false);
				};

				try {
					setSidebarCollapsed(localStorage.getItem(storageKey) === "true");
				} catch (_) {}
				if (mobileQuery.matches) setMobileSidebarOpen(false);

				sidebarToggle?.addEventListener("click", () => {
					if (mobileQuery.matches) {
						setMobileSidebarOpen(shell.dataset.mobileSidebarOpen !== "true");
						return;
					}
					setSidebarCollapsed(shell.dataset.sidebarCollapsed !== "true");
				});
				sidebarClose?.addEventListener("click", closeMobileSidebar);
				mobileOverlay?.addEventListener("click", closeMobileSidebar);

				document.addEventListener("keydown", (event) => {
					if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
						event.preventDefault();
						document.querySelector(".help-search-input")?.focus();
					}
					if (event.key === "Escape") closeMobileSidebar();
				});

				const helpMermaid = window.mermaid;
				if (helpMermaid?.initialize) {
					helpMermaid.initialize({
						startOnLoad: false,
						securityLevel: "antiscript",
						theme: "base",
						fontFamily: "inherit",
						themeVariables: {
							primaryColor: "#eef4ff",
							primaryTextColor: "#1d2939",
							primaryBorderColor: "#84adff",
							lineColor: "#98a2b3",
							secondaryColor: "#f2f4f7",
							tertiaryColor: "#ffffff",
							clusterBkg: "#f8fafc",
							clusterBorder: "#d0d5dd",
							sequenceNumberColor: "#ffffff",
							fontSize: "14px",
						},
					});
				}

				async function renderHelpMermaidDiagrams(root = document) {
					if (!helpMermaid?.run) return;
					const icons = {
						zoomOut: '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>',
						zoomIn: '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M10 4v12M4 10h12" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>',
						reset: '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5.1 6.2A6 6 0 1 1 4 11M5.1 6.2V2.8M5.1 6.2h3.4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
						expand: '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 3.5h-4v4M12.5 3.5h4v4M16.5 12.5v4h-4M7.5 16.5h-4v-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
						collapse: '<svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3.5 7.5h4v-4M16.5 7.5h-4v-4M12.5 16.5v-4h4M7.5 12.5h-4v4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>',
					};
					const createControl = (action, label, icon) => {
						const button = document.createElement("button");
						button.type = "button";
						button.className = "help-mermaid-control";
						button.dataset.diagramAction = action;
						button.setAttribute("aria-label", label);
						button.setAttribute("title", label);
						button.innerHTML = icon;
						return button;
					};
					const blocks = root.querySelectorAll("pre > code.language-mermaid");
					for (const block of blocks) {
						const container = document.createElement("div");
						container.className = "help-mermaid";
						container.setAttribute("role", "group");
						container.setAttribute("aria-label", shell.dataset.diagramLabel);
						container.textContent = block.textContent;
						block.parentElement.replaceWith(container);
						try {
							await helpMermaid.run({ nodes: [container] });
							const diagram = container.querySelector("svg");
							const viewBox = diagram?.viewBox?.baseVal;
							if (!diagram || !viewBox?.width || !viewBox?.height) continue;
							for (const link of container.querySelectorAll("a")) {
								const rawHref = link.getAttribute("href") || link.getAttribute("xlink:href") || "";
								let url;
								try {
									url = new URL(rawHref, window.location.href);
								} catch (_) {
									link.removeAttribute("href");
									link.removeAttribute("xlink:href");
									continue;
								}
								if (url.origin !== window.location.origin || !["http:", "https:"].includes(url.protocol)) {
									link.removeAttribute("href");
									link.removeAttribute("xlink:href");
									continue;
								}
								const safeHref = url.pathname + url.search + url.hash;
								link.setAttribute("href", safeHref);
								link.setAttribute("xlink:href", safeHref);
								link.classList.add("help-mermaid-link");
								link.setAttribute("aria-label", link.textContent?.trim() || safeHref);
							}

							const toolbar = document.createElement("div");
							toolbar.className = "help-mermaid-toolbar";
							toolbar.setAttribute("role", "toolbar");
							toolbar.setAttribute("aria-label", shell.dataset.diagramLabel);

							const zoomOut = createControl("zoom-out", shell.dataset.diagramZoomOutLabel, icons.zoomOut);
							const zoomValue = document.createElement("span");
							zoomValue.className = "help-mermaid-zoom-value";
							zoomValue.setAttribute("aria-live", "polite");
							const zoomIn = createControl("zoom-in", shell.dataset.diagramZoomInLabel, icons.zoomIn);
							const resetZoom = createControl("reset-zoom", shell.dataset.diagramResetZoomLabel, icons.reset);
							const divider = document.createElement("span");
							divider.className = "help-mermaid-toolbar-divider";
							divider.setAttribute("aria-hidden", "true");
							const fullscreen = createControl("fullscreen", shell.dataset.diagramEnterFullscreenLabel, icons.expand);
							toolbar.append(zoomOut, zoomValue, zoomIn, resetZoom, divider, fullscreen);

							const viewport = document.createElement("div");
							viewport.className = "help-mermaid-viewport";
							viewport.tabIndex = 0;
							const canvas = document.createElement("div");
							canvas.className = "help-mermaid-canvas";
							diagram.replaceWith(canvas);
							canvas.appendChild(diagram);
							viewport.appendChild(canvas);
							container.prepend(toolbar);
							container.appendChild(viewport);

							const minZoom = 0.5;
							const maxZoom = 3;
							const zoomStep = 0.25;
							const viewportPadding = parseFloat(getComputedStyle(viewport).paddingLeft) * 2;
							const availableWidth = Math.max(320, viewport.clientWidth - viewportPadding);
							const naturalWidth = Math.min(viewBox.width, 1100);
							const baseWidth = Math.max(availableWidth, naturalWidth);
							let zoom = 1;

							const updateZoom = (nextZoom, focusX, focusY) => {
								const previousZoom = zoom;
								zoom = Math.min(maxZoom, Math.max(minZoom, nextZoom));
								const previousScrollWidth = viewport.scrollWidth;
								const previousScrollHeight = viewport.scrollHeight;
								const anchorX = focusX ?? viewport.clientWidth / 2;
								const anchorY = focusY ?? viewport.clientHeight / 2;
								const contentX = viewport.scrollLeft + anchorX;
								const contentY = viewport.scrollTop + anchorY;
								canvas.style.width = `${Math.round(baseWidth * zoom)}px`;
								zoomValue.textContent = `${Math.round(zoom * 100)}%`;
								zoomValue.setAttribute("aria-label", `${shell.dataset.diagramZoomLevelLabel}: ${zoomValue.textContent}`);
								zoomOut.disabled = zoom <= minZoom;
								zoomIn.disabled = zoom >= maxZoom;
								if (previousZoom !== zoom && previousScrollWidth && previousScrollHeight) {
									requestAnimationFrame(() => {
										viewport.scrollLeft = contentX * (viewport.scrollWidth / previousScrollWidth) - anchorX;
										viewport.scrollTop = contentY * (viewport.scrollHeight / previousScrollHeight) - anchorY;
									});
								}
							};

							const setFullscreen = (enabled) => {
								container.classList.toggle("help-mermaid-fullscreen", enabled);
								document.body.classList.toggle("help-mermaid-fullscreen-open", enabled);
								fullscreen.innerHTML = enabled ? icons.collapse : icons.expand;
								const label = enabled
									? shell.dataset.diagramExitFullscreenLabel
									: shell.dataset.diagramEnterFullscreenLabel;
								fullscreen.setAttribute("aria-label", label);
								fullscreen.setAttribute("title", label);
								fullscreen.setAttribute("aria-pressed", String(enabled));
							};

							zoomOut.addEventListener("click", () => updateZoom(zoom - zoomStep));
							zoomIn.addEventListener("click", () => updateZoom(zoom + zoomStep));
							resetZoom.addEventListener("click", () => updateZoom(1));
							fullscreen.addEventListener("click", () => setFullscreen(!container.classList.contains("help-mermaid-fullscreen")));
							viewport.addEventListener("wheel", (event) => {
								if (!event.ctrlKey && !event.metaKey) return;
								event.preventDefault();
								const bounds = viewport.getBoundingClientRect();
								updateZoom(zoom + (event.deltaY < 0 ? zoomStep : -zoomStep), event.clientX - bounds.left, event.clientY - bounds.top);
							}, { passive: false });
							container.addEventListener("keydown", (event) => {
								if (event.key === "Escape" && container.classList.contains("help-mermaid-fullscreen")) {
									setFullscreen(false);
									fullscreen.focus();
								}
							});
							updateZoom(1);
						} catch (error) {
							console.error("Unable to render Help Center diagram", error);
							const fallback = document.createElement("pre");
							const code = document.createElement("code");
							code.className = "language-mermaid";
							code.textContent = container.textContent;
							fallback.appendChild(code);
							container.replaceWith(fallback);
						}
					}
				}

				function buildTableOfContents(root = document) {
					const article = root.querySelector(".help-article");
					const toc = root.querySelector("[data-help-toc]");
					if (!article || !toc) return;
					toc.replaceChildren();
					const headings = article.querySelectorAll("h2, h3");
					for (const heading of headings) {
						if (!heading.id) continue;
						const link = document.createElement("a");
						link.href = `#${heading.id}`;
						link.textContent = heading.textContent;
						link.className = heading.tagName === "H3" ? "help-toc-link help-toc-link-nested" : "help-toc-link";
						toc.appendChild(link);
					}
					toc.closest(".help-toc")?.toggleAttribute("hidden", headings.length === 0);
					observeActiveHeading(article, toc);
				}

				let headingObserver;
				function observeActiveHeading(article, toc) {
					headingObserver?.disconnect();
					const scroller = document.querySelector(".help-main");
					if (!("IntersectionObserver" in window) || !scroller) return;
					const links = new Map([...toc.querySelectorAll(".help-toc-link")].map((link) => [link.getAttribute("href").slice(1), link]));
					const headings = [...article.querySelectorAll("h2[id], h3[id]")];
					const bandShare = 0.35;
					const markActive = () => {
						const bandEnd = scroller.getBoundingClientRect().top + scroller.clientHeight * bandShare;
						const current = headings.findLast((heading) => heading.getBoundingClientRect().top <= bandEnd);
						for (const [id, link] of links) {
							if (id === current?.id) link.setAttribute("aria-current", "true");
							else link.removeAttribute("aria-current");
						}
					};
					headingObserver = new IntersectionObserver(markActive, {
						root: scroller,
						rootMargin: `0px 0px -${(1 - bandShare) * 100}% 0px`,
					});
					for (const heading of headings) headingObserver.observe(heading);
				}

				document.addEventListener("click", async (event) => {
					const copy = event.target.closest("[data-help-copy-link]");
					if (!copy) return;
					event.preventDefault();
					try {
						if (!navigator.clipboard?.writeText) throw new Error("Clipboard API is unavailable");
						await navigator.clipboard.writeText(window.location.href);
						const label = copy.querySelector("span");
						const original = label.textContent;
						label.textContent = shell.dataset.linkCopiedLabel;
						setTimeout(() => { label.textContent = original; }, 1600);
					} catch (error) {
						console.error("Unable to copy Help Center link", error);
					}
				});

				function enhanceCodeBlocks(root = document) {
					const copyLabel = shell.dataset.copyLabel;
					const copiedLabel = shell.dataset.copiedLabel;
					for (const pre of root.querySelectorAll(".help-article pre")) {
						if (pre.dataset.enhanced === "true" || pre.querySelector(".language-mermaid")) continue;
						pre.dataset.enhanced = "true";
						const button = document.createElement("button");
						button.type = "button";
						button.className = "help-code-copy";
						button.textContent = copyLabel;
						button.addEventListener("click", async () => {
							try {
								if (!navigator.clipboard?.writeText) throw new Error("Clipboard API is unavailable");
								await navigator.clipboard.writeText(pre.querySelector("code")?.textContent || pre.textContent);
								button.textContent = copiedLabel;
								setTimeout(() => { button.textContent = copyLabel; }, 1600);
							} catch (error) {
								console.error("Unable to copy Help Center code block", error);
								button.textContent = copyLabel;
							}
						});
						pre.appendChild(button);
					}
				}

				function enhanceImages(root = document) {
					for (const image of root.querySelectorAll(".help-article img")) {
						if (image.closest("figure")) continue;
						image.loading = "lazy";
						image.decoding = "async";
						const figure = document.createElement("figure");
						figure.className = "help-figure";
						image.replaceWith(figure);
						figure.appendChild(image);
						if (image.title) {
							const caption = document.createElement("figcaption");
							caption.textContent = image.title;
							figure.appendChild(caption);
						}
					}
				}

				function enhanceCallouts(root = document) {
					const labels = {
						NOTE: shell.dataset.noteLabel,
						TIP: shell.dataset.tipLabel,
						IMPORTANT: shell.dataset.importantLabel,
						WARNING: shell.dataset.warningLabel,
						CAUTION: shell.dataset.cautionLabel,
					};
					for (const quote of root.querySelectorAll(".help-article blockquote")) {
						const first = quote.querySelector("p");
						const head = first?.firstChild;
						if (head?.nodeType !== 3) continue;
						const marker = head.textContent.match(/^\[!(NOTE|TIP|IMPORTANT|WARNING|CAUTION)\][ \t]*([^\n]*)\n?/);
						if (!marker) continue;
						quote.classList.add("help-callout", `help-callout-${marker[1].toLowerCase()}`);
						quote.dataset.calloutLabel = marker[2].trim() || labels[marker[1]];
						head.textContent = head.textContent.slice(marker[0].length);
						if (!first.textContent.trim() && !first.querySelector("img")) first.remove();
					}
				}

				function updateActiveNavigation() {
					for (const link of document.querySelectorAll(".help-nav-link")) {
						const active = new URL(link.href, window.location.href).pathname === window.location.pathname;
						if (active) {
							link.setAttribute("aria-current", "page");
						} else {
							link.removeAttribute("aria-current");
						}
					}
					for (const category of document.querySelectorAll(".help-category")) {
						category.open = category.querySelector('.help-nav-link[aria-current="page"]') !== null;
					}
					document.querySelector('.help-nav-link[aria-current="page"]')?.scrollIntoView({ block: "nearest" });
				}

				async function enhanceHelpDocument(root = document) {
					await renderHelpMermaidDiagrams(root);
					buildTableOfContents(root);
					enhanceCodeBlocks(root);
					enhanceImages(root);
					enhanceCallouts(root);
					updateActiveNavigation();
				}

				enhanceHelpDocument();
				document.body.addEventListener("htmx:afterSwap", (event) => {
					enhanceHelpDocument(event.detail.target);
					if (event.detail.target?.id === "help-doc-pane") {
						closeMobileSidebar();
						document.querySelector(".help-main")?.scrollTo({ top: 0 });
					}
				});
			})();
		</script>
	}
}

templ categoryNode(basePath string, node viewmodels.CategoryNode, active *viewmodels.DocView) {
	if node.Path != "" {
		<a
			href={ templ.URL(basePath + "/doc/" + node.Path) }
			hx-get={ basePath + "/doc/" + node.Path }
			hx-target="#help-doc-pane"
			hx-push-url="true"
			class="help-nav-link"
			aria-current={ activePageValue(active, node.Path) }
		>
			{ node.Title }
		</a>
	} else {
		<details class="help-category" open?={ categoryContainsActive(node, active) }>
			<summary>
				<span>{ categoryDisplayTitle(node.Title) }</span>
				<span class="help-category-caret">
					@icons.CaretDown(icons.Props{Size: "12"})
				</span>
			</summary>
			<div class="help-category-children">
				for _, child := range node.Children {
					@categoryNode(basePath, child, active)
				}
			</div>
		</details>
	}
}
