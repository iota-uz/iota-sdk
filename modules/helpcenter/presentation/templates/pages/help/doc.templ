package help

import (
	icons "github.com/iota-uz/icons/phosphor"
	"github.com/iota-uz/iota-sdk/modules/helpcenter/presentation/viewmodels"
	"github.com/iota-uz/iota-sdk/pkg/composables"
)

type DocProps struct {
	BasePath string
	Doc      *viewmodels.DocView
}

templ Doc(props DocProps) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	{{ head, rest := splitAfterLead(string(props.Doc.HTML)) }}
	<div class="help-reading-layout">
		<article class="help-article-card">
			<nav class="help-article-kicker" aria-label={ pageCtx.T("HelpCenter.Breadcrumbs") }>
				<a href={ templ.URL(props.BasePath) }>{ pageCtx.T("HelpCenter.Meta.Title") }</a>
				for _, category := range props.Doc.Categories {
					<span class="help-crumb-sep" aria-hidden="true">/</span>
					<span>{ CategoryDisplayTitle(category) }</span>
				}
			</nav>
			<div class="help-article">
				@templ.Raw(head)
				<div class="help-article-meta">
					if props.Doc.Part != "" {
						<span>
							@templ.Raw(partHTML(props.Doc.Part))
						</span>
					}
					<span>{ readingTimeLabel(ctx, props.Doc.ReadingMinutes) }</span>
					if props.Doc.Audience != "" {
						<span>{ props.Doc.Audience }</span>
					}
					if !props.Doc.Updated.IsZero() {
						<span>{ updatedLabel(ctx, props.Doc.Updated) }</span>
					}
				</div>
				<details class="help-toc-compact" hidden>
					<summary>{ pageCtx.T("HelpCenter.OnThisPage") }</summary>
					<nav class="help-toc-nav" data-help-toc aria-label={ pageCtx.T("HelpCenter.OnThisPage") }></nav>
				</details>
				@templ.Raw(rest)
			</div>
			if props.Doc.Previous != nil || props.Doc.Next != nil {
				<nav class="help-pager" aria-label={ pageCtx.T("HelpCenter.Pager.Label") }>
					if props.Doc.Previous != nil {
						@pagerLink(props.BasePath, *props.Doc.Previous, "help-pager-prev", "← "+pageCtx.T("HelpCenter.Pager.Previous"))
					}
					if props.Doc.Next != nil {
						@pagerLink(props.BasePath, *props.Doc.Next, "help-pager-next", pageCtx.T("HelpCenter.Pager.Next")+" →")
					}
				</nav>
			}
			<footer class="help-article-footer">
				if !props.Doc.Updated.IsZero() {
					<span>{ updatedLabel(ctx, props.Doc.Updated) }</span>
				}
				<span>{ props.Doc.Path }</span>
			</footer>
		</article>
		<aside class="help-toc" aria-label={ pageCtx.T("HelpCenter.OnThisPage") }>
			<div class="help-toc-inner">
				<div class="help-toc-heading">{ pageCtx.T("HelpCenter.OnThisPage") }</div>
				<nav class="help-toc-nav" data-help-toc></nav>
				<div class="help-toc-actions">
					<a href="#" data-help-copy-link>
						@icons.Link(icons.Props{Size: "14"})
						<span>{ pageCtx.T("HelpCenter.Toc.CopyLink") }</span>
					</a>
					if props.Doc.FeedbackURL != "" {
						<a href={ templ.URL(props.Doc.FeedbackURL) } target="_blank" rel="noopener noreferrer">
							@icons.Flag(icons.Props{Size: "14"})
							<span>{ pageCtx.T("HelpCenter.Toc.ReportProblem") }</span>
						</a>
					}
				</div>
			</div>
		</aside>
	</div>
}

templ pagerLink(basePath string, target viewmodels.DocLink, class string, label string) {
	<a
		class={ class }
		href={ templ.URL(basePath + "/doc/" + target.Path) }
		hx-get={ basePath + "/doc/" + target.Path }
		hx-target="#help-doc-pane"
		hx-push-url="true"
	>
		<small>{ label }</small>
		{ target.Title }
	</a>
}
