package projects

import (
	"context"
	"fmt"
	"github.com/iota-uz/iota-sdk/components/base"
	"github.com/iota-uz/iota-sdk/components/base/dialog"
	"github.com/iota-uz/iota-sdk/components/base/input"
	corecomponents "github.com/iota-uz/iota-sdk/modules/core/presentation/templates/components"
	coreviewmodels "github.com/iota-uz/iota-sdk/modules/core/presentation/viewmodels"
	"github.com/iota-uz/iota-sdk/modules/projects/domain/aggregates/acceptance"
	"github.com/iota-uz/iota-sdk/modules/projects/presentation/controllers/dtos"
	"github.com/iota-uz/iota-sdk/pkg/composables"
	"github.com/iota-uz/iota-sdk/pkg/intl"
	"time"
)

// AcceptanceDrawerProps fills the drawer that creates and edits an acceptance
// document.
type AcceptanceDrawerProps struct {
	ProjectID string
	// DocumentID is empty for a new document.
	DocumentID string
	Form       dtos.AcceptanceCreateDTO
	Kinds      []acceptance.KindOption
	Currencies []*coreviewmodels.Currency
	// CurrencyLocked fixes the currency of the document to Form.CurrencyCode.
	CurrencyLocked bool
	Errors         map[string]string
}

func acceptanceDrawerID(projectID string) string {
	return fmt.Sprintf("acceptance-drawer-%s", projectID)
}

// acceptanceSaveURL is where the drawer form posts: the collection for a new
// document and the document itself for an edited one.
func acceptanceSaveURL(props *AcceptanceDrawerProps) string {
	return acceptanceDrawerURL(props.ProjectID, props.DocumentID)
}

// AcceptanceDrawer is the one form of an acceptance document: act, delivery
// note, protocol or a kind the application adds. A signing day signs the
// document and makes its amount revenue; without one it stays a draft.
templ AcceptanceDrawer(props *AcceptanceDrawerProps) {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	{{ container := acceptanceDrawerID(props.ProjectID) }}
	{{ title := pageCtx.T("Projects.Acceptance.New") }}
	if props.DocumentID != "" {
		{{ title = pageCtx.T("Projects.Acceptance.EditTitle") }}
	}
	<div id={ container } data-test-id="acceptance-drawer">
		@dialog.StdViewDrawer(dialog.StdDrawerProps{
			ID:     container + "-dialog",
			Title:  title,
			Action: "open-view-drawer",
			Open:   true,
			Attrs: templ.Attributes{
				"@closed": fmt.Sprintf("document.getElementById('%s')?.remove()", container),
			},
		}) {
			<form
				id="acceptance-form"
				method="post"
				hx-post={ acceptanceSaveURL(props) }
				hx-target={ "#" + container }
				hx-swap="outerHTML"
				novalidate
				class="flex min-h-full flex-col"
			>
				@composables.CSRFTokenField()
				@dialog.DrawerBody() {
					@base.Select(&base.SelectProps{
						Label: pageCtx.T("Projects.Acceptance.Kind"),
						Attrs: templ.Attributes{"name": "Kind"},
						Error: props.Errors["Kind"],
					}) {
						for _, kind := range props.Kinds {
							<option value={ string(kind.Value) } selected?={ props.Form.Kind == string(kind.Value) }>
								{ kindLabel(ctx, props.Kinds, string(kind.Value)) }
							</option>
						}
					}
					<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
						@input.Text(&input.Props{
							Label:       pageCtx.T("Projects.Acceptance.Number"),
							Placeholder: pageCtx.T("Projects.Acceptance.NumberPlaceholder"),
							Attrs:       templ.Attributes{"name": "Number", "value": props.Form.Number, "maxlength": "64", "autocomplete": "off"},
							Error:       props.Errors["Number"],
						})
						@input.Date(&input.Props{
							Label: pageCtx.T("Projects.Acceptance.Date"),
							Attrs: templ.Attributes{"name": "Date", "value": dateValue(time.Time(props.Form.Date))},
							Error: props.Errors["Date"],
						})
					</div>
					@input.Date(&input.Props{
						Label: pageCtx.T("Projects.Acceptance.SignedOn"),
						Attrs: templ.Attributes{"name": "SignedOn", "value": dateValue(time.Time(props.Form.SignedOn))},
						Error: props.Errors["SignedOn"],
					})
					<p class="-mt-2 text-sm text-200">{ pageCtx.T("Projects.Acceptance.SignedOnHint") }</p>
					if props.CurrencyLocked {
						<div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
							@corecomponents.MoneyInput(&corecomponents.MoneyInputProps{
								Label:  pageCtx.T("Projects.Acceptance.Amount"),
								Name:   "Amount",
								Value:  amountText(ctx, props.Form.Amount),
								Error:  props.Errors["Amount"],
								Suffix: props.Form.CurrencyCode,
							})
							@input.Text(&input.Props{
								Label: pageCtx.T("Projects.Acceptance.CurrencyCode"),
								Attrs: templ.Attributes{"value": props.Form.CurrencyCode, "readonly": "true"},
							})
							<input type="hidden" name="CurrencyCode" value={ props.Form.CurrencyCode }/>
						</div>
						<p class="-mt-2 text-sm text-200">{ pageCtx.T("Projects.Acceptance.CurrencyLocked") }</p>
					} else {
						<div class="grid grid-cols-1 gap-4 sm:grid-cols-2" x-data={ currencyScope(props.Form.CurrencyCode) }>
							@corecomponents.MoneyInput(&corecomponents.MoneyInputProps{
								Label:      pageCtx.T("Projects.Acceptance.Amount"),
								Name:       "Amount",
								Value:      amountText(ctx, props.Form.Amount),
								Error:      props.Errors["Amount"],
								SuffixExpr: "currency",
							})
							@corecomponents.CurrencySelect(&corecomponents.CurrencySelectProps{
								Label:       pageCtx.T("Projects.Acceptance.CurrencyCode"),
								Placeholder: pageCtx.T("Projects.Single.SelectCurrency"),
								Value:       props.Form.CurrencyCode,
								Currencies:  props.Currencies,
								Error:       props.Errors["CurrencyCode"],
								Attrs:       templ.Attributes{"name": "CurrencyCode", "@change": "currency = $event.target.value"},
							})
						</div>
					}
					@input.TextArea(&input.TextAreaProps{
						Label: pageCtx.T("Projects.Acceptance._Description"),
						Attrs: templ.Attributes{"name": "Description", "rows": "3"},
						Value: props.Form.Description,
						Error: props.Errors["Description"],
					})
				}
				@dialog.DrawerFooter(dialog.DrawerFooterProps{
					CloseScript: fmt.Sprintf("document.getElementById('%s-dialog').close()", container),
					Delete:      acceptanceDrawerDelete(ctx, props, container),
				})
			</form>
		}
	</div>
}

// acceptanceDrawerDelete asks for confirmation inside the footer, and only the
// confirmed delete reaches the server; a new document has nothing to delete.
func acceptanceDrawerDelete(ctx context.Context, props *AcceptanceDrawerProps, container string) *dialog.DrawerDelete {
	if props.DocumentID == "" {
		return nil
	}
	return &dialog.DrawerDelete{
		ConfirmText: intl.TWithDefault(ctx, "Projects.Acceptance.DeleteConfirmation", "Delete this document?"),
		Attrs: templ.Attributes{
			"hx-delete":    acceptanceSaveURL(props),
			"hx-target":    "#" + container,
			"hx-swap":      "outerHTML",
			"hx-params":    "none",
			"data-test-id": "drawer-delete-confirm",
		},
	}
}
