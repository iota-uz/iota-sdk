{
  "name": "@iota-uz/iota-sdk-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Private workspace for the Go SDK and its canonical frontend distribution.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm --filter @iota-uz/sdk build",
    "pack:sdk": "pnpm --filter @iota-uz/sdk pack",
    "check:sdk": "pnpm --filter @iota-uz/sdk check",
    "build:css": "node scripts/build-tailwind-css.mjs --minify",
    "build:css:watch": "node scripts/build-tailwind-css.mjs --watch",
    "lint": "echo \"no root lint\""
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.1.18",
    "@tailwindcss/postcss": "4.1.18",
    "tailwindcss": "4.1.18"
  },
  "pnpm": {
    "overrides": {
      "@tailwindcss/cli": "4.1.18",
      "@tailwindcss/postcss": "4.1.18"
    }
  }
}
