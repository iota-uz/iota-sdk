package toast

import (
	icons "github.com/iota-uz/icons/phosphor"

	"github.com/iota-uz/iota-sdk/pkg/composables"
	"github.com/iota-uz/iota-sdk/pkg/intl"
)

// Container renders the toast notification container that should be placed once in the layout.
//
// Toasts arrive as `notify` window events (htmx.TriggerToast, $dispatch('notify', …)).
// The detail is {variant, title, message, duration?, action?}; action is
// {label, hxPost? | href?} (see Action). Success and info toasts are polite
// status messages, errors and warnings are alerts. The markup and classes match
// the Solid toast in @iota-uz/sdk/solid-ui.
templ Container() {
	{{ pageCtx := composables.UsePageCtx(ctx) }}
	<div
		x-data="{
			notifications: [],
			sequence: 0,
			addNotification(notification) {
				notification = Object.assign({}, notification || {});
				notification.id = `${Date.now()}-${this.sequence++}`;
				this.notifications.unshift(notification);
				if (this.notifications.length > 20) {
					this.notifications = this.notifications.slice(0, 20);
				}
			},
			removeNotification(id) {
				this.notifications = this.notifications.filter(n => n.id !== id);
			}
		}"
		@notify.window="addNotification($event.detail)"
		@remove-notification.window="removeNotification($event.detail)"
		class={ regionClass }
		data-toast-region
		data-toast-container
		data-error-load-failed={ intl.TWithDefault(ctx, "Common.LoadFailed", "Could not load data") }
		data-error-save-failed={ intl.TWithDefault(ctx, "Common.SaveFailed", "Could not save changes") }
		data-error-network={ intl.TWithDefault(ctx, "Common.NetworkError", "No connection to the server") }
		data-error-network-hint={ intl.TWithDefault(ctx, "Common.NetworkErrorHint", "Check your connection and try again.") }
	>
		<template x-for="notification in notifications" :key="notification.id">
			<div
				x-data={ toastItemData() }
				@mouseenter="hovered = true; sync()"
				@mouseleave="hovered = false; sync()"
				@focusin="focused = true; sync()"
				@focusout="if (!$el.contains($event.relatedTarget)) { focused = false; sync() }"
				x-show="isVisible"
				x-transition:enter="transition ease-out duration-300"
				x-transition:enter-start="opacity-0 translate-x-full"
				x-transition:enter-end="opacity-100 translate-x-0"
				x-transition:leave="transition ease-in duration-300"
				x-transition:leave-start="opacity-100 translate-x-0"
				x-transition:leave-end="opacity-0 translate-x-full"
				class="pointer-events-auto"
			>
				<div
					class={ surfaceClass }
					:role="polite ? 'status' : 'alert'"
					:aria-live="polite ? 'polite' : false"
					data-toast
					:data-variant="variant"
				>
					<div class="flex-shrink-0 w-5 h-5" :class="iconClass">
						<template x-if="variant === 'success'">
							@icons.CheckCircle(icons.Props{Size: "20", Attributes: templ.Attributes{"aria-hidden": "true"}})
						</template>
						<template x-if="variant === 'error' || variant === 'danger'">
							@icons.XCircle(icons.Props{Size: "20", Attributes: templ.Attributes{"aria-hidden": "true"}})
						</template>
						<template x-if="variant === 'warning'">
							@icons.Warning(icons.Props{Size: "20", Attributes: templ.Attributes{"aria-hidden": "true"}})
						</template>
						<template x-if="variant === 'info'">
							@icons.Info(icons.Props{Size: "20", Attributes: templ.Attributes{"aria-hidden": "true"}})
						</template>
					</div>
					<div class="flex-1 min-w-0">
						<template x-if="notification.title">
							<p x-text="notification.title" class="text-sm font-semibold text-toast"></p>
						</template>
						<template x-if="notification.message">
							<p x-text="notification.message" class="text-sm text-toast-muted mt-1"></p>
						</template>
					</div>
					<template x-if="action && action.href">
						<a :href="action.href" class={ actionClass } data-toast-action x-text="action.label" @click="dismiss()"></a>
					</template>
					<template x-if="action && !action.href">
						<button type="button" class={ actionClass } data-toast-action x-text="action.label" @click="runAction()"></button>
					</template>
					<button
						@click="dismiss()"
						type="button"
						class={ closeClass }
						aria-label={ orDefault(pageCtx.TSafe("Common.CloseNotification"), "Close notification") }
					>
						@icons.X(icons.Props{Size: "20", Attributes: templ.Attributes{"aria-hidden": "true"}})
					</button>
				</div>
			</div>
		</template>
	</div>
}

// orDefault keeps a decorative a11y label from taking a page down with it: a
// base component may render wherever a host puts it, including contexts with
// no localizer or a namespaced one where an absolute key does not resolve.
func orDefault(v, def string) string {
	if v == "" {
		return def
	}
	return v
}
