package dialog

import (
	"fmt"
	icons "github.com/iota-uz/icons/phosphor"
	"github.com/iota-uz/iota-sdk/components/base/button"
	"github.com/iota-uz/iota-sdk/pkg/intl"
)

type Props struct {
	Icon        templ.Component
	Heading     string
	Text        string
	Action      string
	Attrs       templ.Attributes
	CancelText  string
	ConfirmText string
	// Danger renders the confirm button as destructive.
	Danger bool
}

templ Confirmation(p *Props) {
	<div
		x-data="dialog"
		{ templ.Attributes{fmt.Sprintf("@%s.window", p.Action): "toggle"}... }
	>
		<dialog
			class="dialog dialog-rounded dialog-btt shadow-lg mb-0 rounded-b-none md:mb-auto md:rounded-b-lg"
			x-bind="dialog"
			{ p.Attrs... }
		>
			<div>
				<header class="flex items-center justify-between gap-3 border-b border-subtle py-1 pl-4 pr-2">
					<h3 class="font-medium" data-dialog-title tabindex="-1">{ p.Heading }</h3>
					<button
						type="button"
						value="cancel"
						class="drawer-close"
						aria-label={ intl.TWithDefault(ctx, "Common.Close", "Close") }
						@click="$el.closest('dialog').close($el.value)"
					>
						@icons.X(icons.Props{Size: "20"})
					</button>
				</header>
				<article class="py-3 px-4 flex flex-col items-center justify-center gap-2 min-h-36">
					if p.Icon != nil {
						<div class="w-12 h-12 bg-red-500/10 rounded-full flex items-center justify-center text-red-500">
							@p.Icon
						</div>
					}
					if p.Text != "" {
						<p class="text-center">
							{ p.Text }
						</p>
					}
					{ children... }
				</article>
				<footer class="px-4 py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))]">
					<menu class="flex flex-col-reverse gap-3 sm:flex-row">
						@button.Secondary(button.Props{
							Class: "min-h-11 flex-1 justify-center",
							Attrs: templ.Attributes{"value": "cancel", "type": "button", "@click": "$el.closest('dialog').close($el.value)", "data-test-id": "dialog-cancel-btn"},
						}) {
							{ p.CancelText }
						}
						@confirmButton(p)
					</menu>
				</footer>
			</div>
		</dialog>
	</div>
}

templ confirmButton(p *Props) {
	if p.Danger {
		@button.Danger(button.Props{
			Class: "min-h-11 flex-1 justify-center",
			Attrs: templ.Attributes{"value": "confirm", "type": "button", "@click": "$el.closest('dialog').close($el.value)", "data-test-id": "dialog-confirm-btn"},
		}) {
			{ p.ConfirmText }
		}
	} else {
		@button.Primary(button.Props{
			Class: "min-h-11 flex-1 justify-center",
			Attrs: templ.Attributes{"value": "confirm", "type": "button", "@click": "$el.closest('dialog').close($el.value)", "data-test-id": "dialog-confirm-btn"},
		}) {
			{ p.ConfirmText }
		}
	}
}
