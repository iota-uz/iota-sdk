package dialog

import (
	"context"
	"fmt"
	icons "github.com/iota-uz/icons/phosphor"
	"github.com/iota-uz/iota-sdk/components/base/button"
	"github.com/iota-uz/iota-sdk/pkg/intl"
	"github.com/iota-uz/iota-sdk/pkg/twmerge"
)

type Direction int

const (
	LTR Direction = iota
	RTL
	BTT
	TTB
)

var directions = map[Direction]string{
	LTR: "dialog-ltr",
	RTL: "dialog-rtl",
	BTT: "dialog-btt",
	TTB: "dialog-ttb",
}

type DrawerProps struct {
	ID        string
	Open      bool
	Direction Direction
	Action    string
	Attrs     templ.Attributes
	Classes   templ.CSSClasses
}

templ Drawer(props DrawerProps) {
	{{
		listener := fmt.Sprintf("@%s.window", props.Action)
		attrs := templ.Attributes{
			"x-data": templ.SafeScriptInline("dialog", props.Open),
			listener: "toggle",
		}
		if props.ID != "" {
			attrs["id"] = props.ID
		}
	}}
	<div
		{ attrs... }
	>
		<dialog
			x-bind="dialog"
			{ props.Attrs... }
			class={
				twmerge.Merge(
					templ.Classes(
						"dialog m-0 bg-transparent",
						directions[props.Direction],
						"w-full h-full max-w-full max-h-full",
						props.Classes,
					).String()),
			}
		>
			{ children... }
		</dialog>
	</div>
}

type StdDrawerProps struct {
	ID     string
	Title  string
	Action string
	Open   bool
	Attrs  templ.Attributes
}

// DrawerHeader is the shared drawer title bar: 16px side padding on phones,
// a 44px close target that is always visible, and a heading that receives focus
// on small screens instead of the first form field.
templ DrawerHeader(title string) {
	<form method="dialog" class="shrink-0">
		<div class="flex min-h-14 items-center justify-between gap-2 border-b border-subtle py-1 pl-4 pr-2 md:pl-6">
			<h3 class="min-w-0 flex-1 truncate font-medium" data-dialog-title tabindex="-1">
				{ title }
			</h3>
			<button
				type="submit"
				class="drawer-close"
				aria-label={ intl.TWithDefault(ctx, "Common.Close", "Close") }
				data-test-id="drawer-close"
			>
				@icons.X(icons.Props{Size: "20"})
			</button>
		</div>
	</form>
}

// DrawerBody pads drawer content: 16px on phones, 24px from md up.
templ DrawerBody() {
	<div class="flex-1 space-y-4 p-4 md:p-6">
		{ children... }
	</div>
}

// DrawerDelete describes the destructive action of a DrawerFooter. Attrs are
// applied to the final confirm button, so an unconfirmed click never reaches
// the server.
type DrawerDelete struct {
	Text        string
	ConfirmText string
	Attrs       templ.Attributes
}

type DrawerFooterProps struct {
	CancelText string
	SubmitText string
	// CloseScript closes the surrounding dialog; defaults to closing the
	// nearest <dialog>.
	CloseScript string
	SubmitAttrs templ.Attributes
	Delete      *DrawerDelete
}

func (p DrawerFooterProps) cancelText(ctx context.Context) string {
	return textOr(p.CancelText, intl.TWithDefault(ctx, "Cancel", "Cancel"))
}

func (p DrawerFooterProps) submitText(ctx context.Context) string {
	return textOr(p.SubmitText, intl.TWithDefault(ctx, "Save", "Save"))
}

func (p DrawerFooterProps) closeScript() string {
	return textOr(p.CloseScript, "$el.closest('dialog').close()")
}

func textOr(v, fallback string) string {
	if v == "" {
		return fallback
	}
	return v
}

func (p DrawerFooterProps) submitAttrs() templ.Attributes {
	attrs := templ.Attributes{"type": "submit", "data-test-id": "drawer-save"}
	for k, v := range p.SubmitAttrs {
		attrs[k] = v
	}
	return attrs
}

func (d DrawerDelete) confirmAttrs() templ.Attributes {
	attrs := templ.Attributes{"type": "button", "data-test-id": "drawer-delete-confirm"}
	for k, v := range d.Attrs {
		attrs[k] = v
	}
	return attrs
}

// DrawerFooter is the shared action bar: it sticks to the bottom of the drawer
// body, shows "Cancel" + "Save" in the same order everywhere, and keeps the
// destructive action on its own row (phones) or at the far end (desktop), behind
// an inline confirmation. Place it as the last child of the drawer form, whose
// height should be min-h-full rather than h-full so the bar can stick.
templ DrawerFooter(props DrawerFooterProps) {
	<div
		x-data="{ confirmingDelete: false }"
		class="sticky bottom-0 z-10 mt-auto shrink-0 border-t border-subtle bg-surface-300 px-4 py-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] md:px-6"
		data-test-id="drawer-footer"
	>
		<div
			class="flex flex-col-reverse gap-3 sm:flex-row sm:items-center sm:justify-end"
			x-show="!confirmingDelete"
		>
			if props.Delete != nil {
				@button.Danger(button.Props{
					Class: "mt-3 min-h-11 w-full justify-center sm:mr-auto sm:mt-0 sm:w-auto",
					Attrs: templ.Attributes{
						"type":         "button",
						"@click":       "confirmingDelete = true",
						"data-test-id": "drawer-delete",
					},
				}) {
					{ textOr(props.Delete.Text, intl.TWithDefault(ctx, "Delete", "Delete")) }
				}
			}
			@button.Secondary(button.Props{
				Class: "min-h-11 w-full justify-center sm:w-auto",
				Attrs: templ.Attributes{
					"type":         "button",
					"@click":       props.closeScript(),
					"data-test-id": "drawer-cancel",
				},
			}) {
				{ props.cancelText(ctx) }
			}
			@button.Primary(button.Props{
				Class: "min-h-11 w-full justify-center sm:w-auto",
				Attrs: props.submitAttrs(),
			}) {
				{ props.submitText(ctx) }
			}
		</div>
		if props.Delete != nil {
			<div class="flex flex-col gap-3" x-show="confirmingDelete" x-cloak>
				<p class="text-sm" role="alert">
					{ textOr(props.Delete.ConfirmText, intl.TWithDefault(ctx, "ConfirmDelete", "Are you sure you want to delete this item?")) }
				</p>
				<div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
					@button.Secondary(button.Props{
						Class: "min-h-11 w-full justify-center sm:w-auto",
						Attrs: templ.Attributes{
							"type":   "button",
							"@click": "confirmingDelete = false",
						},
					}) {
						{ props.cancelText(ctx) }
					}
					@button.Danger(button.Props{
						Class: "min-h-11 w-full justify-center sm:w-auto",
						Attrs: props.Delete.confirmAttrs(),
					}) {
						{ textOr(props.Delete.Text, intl.TWithDefault(ctx, "Delete", "Delete")) }
					}
				</div>
			</div>
		}
	</div>
}

templ StdViewDrawer(props StdDrawerProps) {
	@Drawer(DrawerProps{
		ID:        props.ID,
		Direction: RTL,
		Open:      props.Open,
		Action:    props.Action,
		Classes:   templ.Classes("flex items-stretch"),
		Attrs:     props.Attrs,
	}) {
		<div class="ml-auto w-full bg-surface-300 sm:w-3/4 md:w-2/3">
			<div class="flex h-full flex-col">
				@DrawerHeader(props.Title)
				<div class="min-h-0 flex-1 overflow-y-auto">
					{ children... }
				</div>
			</div>
		</div>
	}
}
