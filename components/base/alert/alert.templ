package alert

templ Error() {
	<div class="bg-red-100 text-pink py-2.5 px-4 text-sm font-medium rounded-md w-full text-center">
		<span>
			{ children... }
		</span>
	</div>
}

templ Success() {
	<div class="bg-badge-green text-green py-2.5 px-4 text-sm font-medium rounded-md w-full text-center">
		<span>
			{ children... }
		</span>
	</div>
}
