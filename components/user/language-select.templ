// Package usercomponents provides user account and profile-related components.
//
// It includes components for user settings, preferences, and profile management.
package usercomponents

import (
	"context"

	"github.com/iota-uz/iota-sdk/components/base"
	"github.com/iota-uz/iota-sdk/pkg/application"
	"github.com/iota-uz/iota-sdk/pkg/intl"
)

// LanguageSelectProps defines the properties for the LanguageSelect component.
type LanguageSelectProps struct {
	Label       string                   // Label text for the select
	Placeholder string                   // Placeholder text when no language is selected
	Value       string                   // Pre-selected language code
	Error       string                   // Error message to display
	Attrs       templ.Attributes         // Additional HTML attributes
	Languages   []intl.SupportedLanguage // List of languages to display (if nil/empty, defaults to the application's enabled languages)
}

// enabledLanguages returns the languages enabled on the application attached to
// ctx, or every SDK language when no application is available.
func enabledLanguages(ctx context.Context) []intl.SupportedLanguage {
	app, err := application.UseApp(ctx)
	if err != nil {
		return intl.SupportedLanguages
	}
	return intl.GetSupportedLanguages(app.GetSupportedLanguages())
}

// LanguageSelect renders a dropdown for selecting the application language.
// It displays supported languages with their verbose names.
// If Languages is nil or empty, it defaults to the languages enabled on the
// application, or every SDK language when no application is in the context.
// withSavedLanguage keeps the currently saved language selectable even when it
// is no longer enabled, so saving an unrelated change does not silently require
// picking a new language.
func withSavedLanguage(languages []intl.SupportedLanguage, saved string) []intl.SupportedLanguage {
	if saved == "" {
		return languages
	}
	for _, lang := range languages {
		if lang.Code == saved {
			return languages
		}
	}
	known := intl.GetSupportedLanguages([]string{saved})
	if len(known) == 0 {
		return languages
	}
	return append(append([]intl.SupportedLanguage(nil), languages...), known[0])
}

templ LanguageSelect(props *LanguageSelectProps) {
	{{ languages := props.Languages }}
	{{
		if len(languages) == 0 {
			languages = enabledLanguages(ctx)
		}
		languages = withSavedLanguage(languages, props.Value)
	}}
	@base.Select(&base.SelectProps{
		Label:       props.Label,
		Placeholder: props.Placeholder,
		Attrs:       props.Attrs,
		Error:       props.Error,
	}) {
		for _, lang := range languages {
			if lang.Code == props.Value {
				<option value={ lang.Code } selected>
					{ lang.VerboseName }
				</option>
			} else {
				<option value={ lang.Code }>
					{ lang.VerboseName }
				</option>
			}
		}
	}
}
