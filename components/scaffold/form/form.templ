package form

import (
	"fmt"

	icons "github.com/iota-uz/icons/phosphor"
	"github.com/iota-uz/iota-sdk/components/base/button"
	"github.com/iota-uz/iota-sdk/components/base/card"
	"github.com/iota-uz/iota-sdk/components/base/dialog"
	"github.com/iota-uz/iota-sdk/modules/core/presentation/templates/layouts"
	"github.com/iota-uz/iota-sdk/pkg/composables"
)

// FormFields renders all fields in the form
templ FormFields(cfg *FormConfig) {
	for _, f := range cfg.Fields {
		@f.Component()
	}
}

// FormFooter renders the shared save/delete action bar
templ FormFooter(cfg *FormConfig) {
	{{ pgCtx := composables.UsePageCtx(ctx) }}
	<div
		x-data
		class="h-16 md:h-20 shadow-t-lg border-t w-full flex items-center justify-end px-4 md:px-8 bg-surface-300 border-t-primary mt-auto gap-4"
	>
		<form
			id="delete-form"
			hx-delete={ cfg.DeleteURL }
			hx-trigger="submit"
			hx-target="closest .content"
			hx-swap="innerHTML"
			hx-indicator="#delete-user-btn"
			hx-disabled-elt="find button"
		>
			@button.Danger(button.Props{
				Size: button.SizeMD,
				Attrs: templ.Attributes{
					"name":   "_action",
					"value":  "delete",
					"type":   "button",
					"@click": "$dispatch('open-delete-user-confirmation')",
					"id":     "delete-user-btn",
				},
			}) {
				{ pgCtx.T("Delete") }
			}
		</form>
		@button.Primary(button.Props{
			Size: button.SizeMD,
			Attrs: templ.Attributes{
				"name":  "_action",
				"value": "save",
				"type":  "submit",
				"id":    "save-btn",
			},
		}) {
			{ pgCtx.T("Save") }
		}
	</div>
	// The Delete button only opens this dialog; without it the click went
	// nowhere and a CRUD record could not be deleted from its form.
	//
	// The DELETE is sent from here rather than by submitting #delete-form:
	// that form sits inside #save-form, and the HTML parser drops a form nested
	// in another, so it never reaches the page. The response is the
	// controller's HX-Redirect back to the list.
	@dialog.Confirmation(&dialog.Props{
		Heading: pgCtx.T("Delete"),
		Text:    pgCtx.T("ConfirmDelete"),
		Icon:    icons.Trash(icons.Props{Size: "20"}),
		Action:  "open-delete-user-confirmation",
		Attrs: templ.Attributes{
			"@closing": fmt.Sprintf(`({target}) => {
				if (target.returnValue === "confirm") {
					htmx.ajax("DELETE", %q, {source: "#delete-user-btn"});
				}
			}`, cfg.DeleteURL),
		},
		CancelText:  pgCtx.T("Cancel"),
		ConfirmText: pgCtx.T("Delete"),
	})
}

// Form renders a dynamic form using a slice of scaffold.Field
templ Form(cfg *FormConfig) {
	<div class="flex flex-col justify-between h-[calc(100vh-4rem)]" id="edit-content">
		<form
			id="save-form"
			method="post"
			hx-post={ cfg.SaveURL }
			hx-indicator="#save-btn"
			hx-target="#edit-content"
			hx-swap="outerHTML"
			class="flex flex-col flex-1"
		>
			<div class="flex-1 overflow-y-auto p-4 md:p-6">
				@card.Card(card.Props{
					Class: "grid grid-cols-1 md:grid-cols-2 gap-4",
				}) {
					@FormFields(cfg)
				}
			</div>
			@FormFooter(cfg)
		</form>
	</div>
}

// FormContent renders just the form content without the edit-content wrapper (for HTMX responses)
templ FormContent(cfg *FormConfig) {
	<form
		id="save-form"
		method="post"
		hx-post={ cfg.SaveURL }
		hx-indicator="#save-btn"
		hx-target="#edit-content"
		hx-swap="outerHTML"
		class="flex flex-col flex-1"
	>
		<div class="flex-1 overflow-y-auto p-4 md:p-6">
			@card.Card(card.Props{
				Class: "grid grid-cols-1 md:grid-cols-2 gap-4",
			}) {
				@FormFields(cfg)
			}
		</div>
		@FormFooter(cfg)
	</form>
}

// FormWithErrors renders inner form content with validation errors for HTMX innerHTML replacement
templ FormWithErrors(cfg *FormConfig, fieldErrors map[string]string) {
	<div class="flex flex-col justify-between h-[calc(100vh-4rem)]" id="edit-content">
		if len(fieldErrors) > 0 {
			<small data-testid="field-error" class="text-red-500">Field validation failed</small>
		}
		<form
			id="save-form"
			method="post"
			hx-post={ cfg.SaveURL }
			hx-indicator="#save-btn"
			hx-target="#edit-content"
			hx-swap="outerHTML"
			class="flex flex-col flex-1"
		>
			<div class="flex-1 overflow-y-auto p-4 md:p-6">
				@card.Card(card.Props{
					Class: "grid grid-cols-1 md:grid-cols-2 gap-4",
				}) {
					@FormFields(cfg)
				}
			</div>
			@FormFooter(cfg)
		</form>
	</div>
}

// Page wraps Form in authenticated layout
templ Page(cfg *FormConfig) {
	@layouts.Authenticated(layouts.AuthenticatedProps{
		BaseProps: layouts.BaseProps{Title: cfg.Title},
	}) {
		@Form(cfg)
	}
}
